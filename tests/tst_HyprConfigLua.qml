import QtQuick
import QtTest
import qs.components.methods

// HyprConfigLua: the binds' Lua, the included module, the managed
// hyprland.lua and the one given back. The files also go to tests/.out/,
// where scripts/run_tests.sh checks them with `luac -p`.
TestCase {
  name: "HyprConfigLua"

  RepoFiles {
    id: files
  }

  readonly property var ctx: ({
      "shellCommand": "qs -p '/opt/axiom'",
      "restartCommand": "'/opt/axiom/scripts/restart.sh'",
      "terminal": "kitty",
      "fileManager": "thunar",
      "browser": "firefox"
    })

  readonly property var motion: ({
      "fast": 150,
      "normal": 250,
      "slow": 400,
      "enabled": true
    })

  // Every default in an object schema, nested objects included
  function _defaults(objectSchema) {
    const values = {};
    for (const key of Object.keys(objectSchema.properties ?? {})) {
      const field = objectSchema.properties[key];
      values[key] = field.type === "object" && field.default === undefined ? _defaults(field) : field.default;
    }
    return values;
  }

  function _hyprlandSchema() {
    return files.json("config/json/config.schema.json").properties.Hyprland.properties;
  }

  function _module(binds) {
    return HyprConfigLua.moduleLua({
      "header": "-- Generated by axiom",
      "includeLines": "local ok, axiom = pcall(dofile, \"/s/hyprland.lua\")\nif ok then axiom.setup() end",
      "requiredSettings": true,
      "binds": HyprConfigLua.bindLines(binds, ctx),
      "look": ["hl.config({ general = { border_size = 2 } })"],
      "input": ["hl.config({ input = { kb_layout = \"us\" } })"],
      "blur": [],
      "layers": HyprLua.layerRulesLua(),
      "monitors": HyprLua.monitorsLua([]),
      "strips": []
    });
  }

  function _write(path, text) {
    const written = files.write(path, text);
    tryVerify(() => written.done, 2000);
  }

  // --- Binds ---

  function test_ipcBind() {
    compare(HyprConfigLua.bindLua({
      "key": " SUPER + D ",
      "action": "launcher",
      "call": "open"
    }, ctx), `hl.bind("SUPER + D", hl.dsp.exec_cmd("qs -p '/opt/axiom' ipc call appLauncher open"), { description = "Axiom: App launcher (open)" })`);
  }

  function test_argumentIsAShellWord() {
    const line = HyprConfigLua.bindLua({
      "key": "SUPER + S",
      "action": "screenshot",
      "argument": "it's"
    }, ctx);
    verify(line.includes(`screenshot take 'it'\\\\''s'`), line);
  }

  function test_flags() {
    const line = HyprConfigLua.bindLua({
      "key": "XF86AudioRaiseVolume",
      "action": "volumeUp",
      "repeating": true,
      "locked": true,
      "release": false
    }, ctx);
    verify(line.endsWith(`{ description = "Media: Volume up", repeating = true, locked = true })`), line);
  }

  function test_tapIsWrittenWithItsModifierOnRelease() {
    const bind = {
      "key": "Super_L",
      "action": "launcher"
    };
    compare(HyprConfigLua.bindKey(bind.key), "SUPER + Super_L");
    compare(HyprConfigLua.bindKey(" SUPER + Q "), "SUPER + Q");
    verify(HyprConfigLua.bindLua(bind, ctx).startsWith(`hl.bind("SUPER + Super_L", `));
    verify(HyprConfigLua.bindLua(bind, ctx).endsWith(`release = true })`));
    const flagged = HyprConfigLua.bindLua(Object.assign({
      "release": true
    }, bind), ctx);
    compare(flagged.split("release = true").length, 2, "release once");
  }

  function test_incompleteBinds() {
    compare(HyprConfigLua.bindLua({
      "key": "",
      "action": "lock"
    }, ctx), "", "no key");
    compare(HyprConfigLua.bindLua({
      "key": "SUPER + 1",
      "action": "workspaceNth",
      "argument": " "
    }, ctx), "", "a needed argument missing");
    compare(HyprConfigLua.bindLua({
      "key": "SUPER + R",
      "action": "resizeWindow",
      "argument": "wide"
    }, ctx), "", "an argument the dispatcher can't use");
    compare(HyprConfigLua.bindLua({
      "key": "SUPER + R",
      "action": "unknown"
    }, ctx), "");
    compare(HyprConfigLua.bindLua({
      "key": "SUPER + R",
      "action": "raw",
      "compositor": "sway",
      "argument": "splitv"
    }, ctx), "", "a raw command for another compositor");
    verify(HyprConfigLua.bindLua({
      "key": "SUPER + R",
      "action": "raw",
      "compositor": "hyprland",
      "argument": "hl.dsp.layout(\"swapsplit\")"
    }, ctx).startsWith("hl.bind("));
  }

  function test_compositorActions() {
    compare(HyprConfigLua.dispatcherLua("resizeWindow", "10, -20", ctx), "hl.dsp.window.resize({ x = 10, y = -20, relative = true })");
    compare(HyprConfigLua.dispatcherLua("stripSwapColumn", "up", ctx), `hl.dsp.layout("swapcol l")`);
    compare(HyprConfigLua.dispatcherLua("terminal", "", ctx), `hl.dsp.exec_cmd("kitty")`);
    verify(HyprConfigLua.dispatcherLua("restartShell", "", ctx).includes("'/opt/axiom/scripts/restart.sh'"));
    for (const action of Object.keys(BindActions.compositorActions))
      verify(HyprConfigLua.dispatcherLua(action, action === "resizeWindow" ? "10 10" : "left", ctx) !== "", action + " has no Lua");
  }

  function test_switcherBindsGetTheSubmap() {
    const lines = HyprConfigLua.bindLines([
      {
        "key": "ALT + Tab",
        "action": "windowSwitcher"
      }
    ], ctx);
    verify(lines[0].startsWith(`hl.bind("ALT + Tab", function()`), lines[0]);
    verify(lines.some(line => line.includes(`hl.bind("ALT + Tab", function() hl.dispatch(hl.dsp.event("axiom-switcher:step 1"))`)), "the submap steps on the same combo");
  }

  // --- Files ---

  function test_module() {
    const lua = _module([
      {
        "key": "SUPER + Return",
        "action": "terminal"
      },
      {
        "key": "SUPER + Q",
        "action": "closeWindow"
      }
    ]);
    verify(lua.includes("AXIOM_INCLUDED = true"));
    verify(lua.includes("function M.setup()\n  M.required()\n  M.binds()"));
    verify(lua.includes("  M.look()\n  M.input()\n"), "the input after the look");
    verify(lua.includes(`  hl.bind("SUPER + Q", hl.dsp.window.close(), { description = "Window: Close" })`));
    verify(lua.includes("--   local ok, axiom = pcall(dofile, \"/s/hyprland.lua\")\n--   if ok then axiom.setup() end"), "the include lines are shown commented");
    _write("tests/.out/included.lua", lua);
  }

  // The managed hyprland.lua with every part of the look and the input on,
  // every default bind and a monitor profile: run_tests.sh has Hyprland
  // read it (--verify-config, where it's installed), so an option Hyprland
  // refuses fails here, not in a user's session
  function test_everything_on_is_a_config_hyprland_reads() {
    const schema = files.json("config/json/config.schema.json");
    const root = schema.properties;
    const lookValues = SchemaValidation.applyDefaults({}, root.WindowLook, schema);
    for (const part of CompositorLayer.lookPartNames)
      lookValues[part] = true;
    Object.assign(lookValues, {
      "matchShell": false,
      "windowBlur": true,
      "blurXray": true,
      "blurPopups": true,
      "blurSpecial": true
    });
    const spec = CompositorLayer.look(lookValues, {
      "activeHex": "9ccfd8",
      "inactiveHex": "403d52",
      "borderWidth": 3,
      "radius": 12,
      "surfacesBlur": true,
      "shadow": {
        "size": 14,
        "color": "c4a7e7",
        "alpha": 0.5,
        "offset": 3,
        "soft": true
      }
    });
    const inputValues = SchemaValidation.applyDefaults({}, root.Input, schema);
    for (const part of CompositorLayer.inputPartNames)
      inputValues[part] = true;
    inputValues.cursorTheme = "Adwaita";
    const ruleSchema = schema.definitions.MonitorRule;
    const profile = {
      "name": "Desk",
      "outputs": [Object.assign(SchemaValidation.applyDefaults({}, ruleSchema, schema), {
          "output": "DP-1",
          "mode": "2560x1440@144",
          "vrr": 2,
          "bitdepth": 10
        }), Object.assign(SchemaValidation.applyDefaults({}, ruleSchema, schema), {
          "output": "HDMI-A-1",
          "disabled": true
        })]
    };
    const module = HyprConfigLua.moduleLua({
      "header": "-- Generated by axiom",
      "includeLines": "",
      "requiredSettings": true,
      "binds": HyprConfigLua.bindLines(root.Keybinds.properties.binds["default"], ctx),
      "look": HyprLua.lookLua(spec, root.WindowLook),
      "input": HyprLua.inputLua(CompositorLayer.input(inputValues), root.Input),
      "blur": HyprLua.blurLua({
        "blur": true,
        "threshold": 0.5,
        "throughWindows": true,
        "backdrops": true
      }),
      "layers": HyprLua.layerRulesLua(),
      "monitors": HyprLua.monitorsLua([profile]),
      "strips": []
    });
    verify(module.includes("offset = { 0, 3 }"));
    const lua = HyprConfigLua.managedLua(module, _defaults(_hyprlandSchema().managed), {
      "header": "-- Generated by axiom",
      "userDir": "/nonexistent/axiom-test/user",
      "session": _defaults(root.Session),
      "env": CompositorLayer.sessionEnv(_defaults(root.Session), {
        "theme": "Adwaita",
        "size": 24
      }),
      "cursor": {
        "theme": "Adwaita",
        "size": 24
      },
      "schema": _hyprlandSchema().managed,
      "resolveHex": () => "112233",
      "motion": motion,
      "start": {
        "command": "true",
        "idle": false,
        "polkit": false
      }
    });
    _write("tests/.out/everything.hypr.lua", lua);
  }

  function test_emptyModule() {
    const lua = HyprConfigLua.emptyModuleLua("-- Generated by axiom");
    verify(lua.startsWith("-- Generated by axiom: Hyprland mode"));
    _write("tests/.out/includedEmpty.lua", lua);
  }

  function test_managed() {
    const schema = _hyprlandSchema();
    const root = files.json("config/json/config.schema.json").properties;
    const m = _defaults(schema.managed);
    const session = Object.assign(_defaults(root.Session), {
      "autostart": [
        {
          "enabled": true,
          "command": "waybar"
        },
        {
          "enabled": true,
          "command": "hypridle"
        },
        {
          "enabled": false,
          "command": "nm-applet"
        }
      ],
      "env": [
        {
          "name": "FOO",
          "value": "bar"
        },
        {
          "name": "1BAD",
          "value": "x"
        }
      ]
    });
    const lua = HyprConfigLua.managedLua(_module([]), m, {
      "header": "-- Generated by axiom",
      "userDir": "/home/u/.config/hypr/user",
      "session": session,
      "env": CompositorLayer.sessionEnv(session, {
        "theme": "Bibata",
        "size": 24
      }),
      "cursor": {
        "theme": "Bibata",
        "size": 24
      },
      "schema": schema.managed,
      "resolveHex": () => "112233",
      "motion": motion,
      "start": {
        "command": "qs -p '/opt/axiom' -n",
        "idle": true,
        "polkit": false
      }
    });
    verify(!lua.includes("\n  --"), "the module's comments are dropped");
    verify(lua.includes(`hl.env("FOO", "bar")`));
    verify(!lua.includes("1BAD"), "an invalid variable name is left out");
    verify(lua.includes(`hl.env("XCURSOR_THEME", "Bibata")`));
    verify(lua.includes(`  hl.exec_cmd("waybar")`));
    verify(!lua.includes(`hl.exec_cmd("hypridle")`), "axiom's idle replaces a plain hypridle");
    verify(!lua.includes("nm-applet"), "disabled autostart entries are left out");
    verify(lua.includes("local files = io.popen(\"cd \" .. \"'/home/u/.config/hypr/user'\""));
    _write("tests/.out/managedFile.lua", lua);
  }

  function test_released() {
    const lua = HyprConfigLua.releasedLua("/home/u/.config/hypr/user", `hl.on("hyprland.start", function() hl.exec_cmd("qs -p '/opt/axiom' -n") end) -- axiom`);
    verify(lua.includes("if select(\"#\", ...) == 0 then\n  -- Your files"));
    _write("tests/.out/released.lua", lua);
  }

  // --- Animations ---

  function test_animationsFollowMotion() {
    const lua = HyprConfigLua.animationsLua({
      "animations": true,
      "animationPreset": "axiom"
    }, motion);
    verify(lua.includes(`hl.animation({ leaf = "windows", enabled = true, speed = 4, bezier = "axiomMotion", style = "popin 80%" })`), lua);
    compare(HyprConfigLua.animationsLua({
      "animations": true,
      "animationPreset": "axiom"
    }, Object.assign({}, motion, {
      "enabled": false
    })), "", "off while the shell's motion is off");
    compare(HyprConfigLua.animationsLua({
      "animations": true,
      "animationPreset": "hyprland"
    }, motion), "", "Hyprland's own");
  }

  function test_customAnimations() {
    const set = HyprConfigLua.animationSet({
      "animationPreset": "custom",
      "curves": [
        {
          "name": " c1 ",
          "points": "0.1,0.2,0.3,1"
        },
        {
          "name": "bad",
          "points": "1,2"
        }
      ],
      "customAnimations": [
        {
          "leaf": "fade",
          "enabled": false,
          "durationMs": 100,
          "curve": " ",
          "style": ""
        }
      ]
    }, motion);
    compare(Object.keys(set.curves), ["c1"], "an incomplete curve is dropped");
    compare(set.leaves, [["fade", 0, "default", ""]]);
  }
}
