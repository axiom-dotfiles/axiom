{
  "Widget": { "height": 26 },
  "General": { "monitors": "all" },
  "Appearance": { "autoThemeSwitch": true },
  "Popouts": { "workspaceIcons": true },
  "OSD": { "apps": [{ "app": "spotify", "icon": "music_note", "showOsd": false }, { "app": "other", "icon": "", "showOsd": true }, { "app": "master" }] },
  "Bars": [
    {
      "id": "main",
      "extent": 34,
      "widgets": {
        "left": [
          { "type": "Workspaces", "properties": { "iconColor": "base0D" } },
          { "type": "Button", "properties": { "icon": "\udb82\udcc7" } }
