        "right": [{ "type": "Network", "properties": { "interval": 5000, "showName": true } }, { "type": "Time" }]
      }
    }
  ],
  "Overlay": {
    "views": [
      {
        "type": "Custom",
        "columns": [
          { "cells": [{ "layout": "Single", "slots": { "main": { "type": "Settings" } } }] }
