      },
      {
        "type": "Custom",
        "columns": [
          {
            "cells": [
              { "layout": "Single", "slots": { "main": { "type": "QuickToggles" } } },
              { "layout": "Single", "slots": { "main": { "type": "Session", "properties": { "actions": ["lock", "reboot"] } } } }
            ]
          }
        ]
      }
    ]
  },
  "Chat": {
    "enabled": true,
    "defaultBackend": "anthropic",
    "backends": {
      "anthropic": { "defaultModel": "claude-sonnet-4-20250514", "models": ["claude-sonnet-4-20250514", "my-own-model"] }
    }
