#!/usr/bin/env bash
# Regenerates what's built from the code being committed (the index, not the
# working tree) and stages it, so a commit never carries stale output:
#   - docs/dev/config and docs/dev/generated (scripts/gen_docs.py)
#   - the translations (scripts/check_i18n.py --fill): every new key, empty,
#     in each config/i18n/<code>.json, and the empty template a new language
#     is copied from, config/i18n/template/language.json
#   - the theme template, config/themes/template/theme.json
#     (scripts/gen_theme_template.py)
# Enabled per clone with
#   git config core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged="$(git diff --cached --name-only --diff-filter=ACMRD)"
docs=0 i18n=0 theme=0
grep -qE '\.qml$|^config/json/config\.schema\.json$|^scripts/(gen_docs|qml_modules)\.py$' <<<"$staged" && docs=1
grep -qE '\.qml$|^config/json/config\.schema\.json$|^scripts/check_i18n\.py$|^config/i18n/' <<<"$staged" && i18n=1
grep -qE '^config/json/theme-defaults\.json$|^scripts/gen_theme_template\.py$|^config/themes/template/' <<<"$staged" && theme=1
[[ $docs -eq 1 || $i18n -eq 1 || $theme -eq 1 ]] || exit 0

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git checkout-index --all --prefix="$tmp/"

# Into the working tree by rename, so the shell (watching the active
# dictionary) never reads a half-written file
place() {
  cp "$tmp/$1" "$1.tmp"
  mv "$1.tmp" "$1"
  git add "$1"
}

if [[ $docs -eq 1 ]]; then
  if [[ ! -f "$tmp/scripts/gen_docs.py" ]]; then
    echo "pre-commit: scripts/gen_docs.py isn't committed yet; skipping doc generation" >&2
  else
    python3 "$tmp/scripts/gen_docs.py" >/dev/null
    for dir in docs/dev/config docs/dev/generated; do
      rm -rf "$dir"
      mkdir -p "$(dirname "$dir")"
      cp -r "$tmp/$dir" "$dir"
      git add -A "$dir"
    done
  fi
fi

if [[ $i18n -eq 1 && -f "$tmp/scripts/check_i18n.py" ]]; then
  # Exits 1 while entries are untranslated, which is fine to commit
  python3 "$tmp/scripts/check_i18n.py" --fill >/dev/null || true
  template=config/i18n/template/language.json
  mkdir -p "$(dirname "$template")"
  cmp -s "$tmp/$template" <(git show ":$template" 2>/dev/null) || place "$template"
  for file in "$tmp"/config/i18n/*.json; do
    rel="config/i18n/$(basename "$file")"
    cmp -s "$file" <(git show ":$rel") && continue
    # A language file with unstaged edits is left alone: filling it from the
    # index would drop them
    if git diff --quiet -- "$rel"; then
      place "$rel"
    else
      echo "pre-commit: $rel has unstaged edits, so its new keys weren't added; stage it and commit again" >&2
      exit 1
    fi
  done
fi

if [[ $theme -eq 1 && -f "$tmp/scripts/gen_theme_template.py" ]]; then
  python3 "$tmp/scripts/gen_theme_template.py" >/dev/null
  template=config/themes/template/theme.json
  mkdir -p "$(dirname "$template")"
  cmp -s "$tmp/$template" <(git show ":$template" 2>/dev/null) || place "$template"
fi
