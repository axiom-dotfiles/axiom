pragma Singleton
pragma ComponentBehavior: Bound

import QtQuick
import Quickshell

import qs.config
import qs.components.methods

/*
 * Sway's config writer (docs/dev/compositor/config-modes.md), reached as
 * SwayManager.configWriter by CompositorConfigManager, which drives the
 * modes. Turns axiom's layer (binds, the window look, input) into sway's
 * commands (SwayConf):
 *   detached  sent at runtime (SwayRuntimeLayer); binds on keys the user's
 *             config already binds are skipped
 *   included  the file at $XDG_STATE_HOME/axiom/sway.conf, which the user's
 *             sway config includes (includeLines)
 *   managed   not yet: falls back to the runtime layer (blockedProblem)
 * Monitor profiles aren't written: MonitorManager applies the one for
 * what's connected at start and on every hotplug.
 */
Singleton {
  id: root

  // Configured keys the runtime layer skipped because the user's sway
  // config already binds them
  readonly property var skippedKeys: runtime.skippedKeys

  // --- Files and the lines a user's config needs ---

  readonly property string configDir: Paths.swayPath
  readonly property string includePath: Paths.userStatePath + "sway.conf"
  readonly property string managedPath: Paths.swayPath + "config"
  readonly property string userDir: Paths.swayPath + "user"
  readonly property string userFiles: userDir + "/*"
  // What the user's sway config needs for the included mode
  readonly property string includeLines: `include ${SwayConf.quote(includePath)}`
  // What a sway config needs to start axiom with sway, for the detached and
  // included modes. -n (--no-duplicate) exits at once if axiom already
  // runs, so a reload can't start another copy.
  readonly property string autostartLines: `exec ${startCommand}`

  // The lines above as integration_hookup.py targets in the user's sway
  // config (IntegrationHookupManager's "compositorInclude" and
  // "compositorAutostart"): the include first, so what follows overrides
  // it, and the autostart last. Any line starting axiom counts.
  readonly property var includeTarget: ({
      // I18n.tr("Load axiom's module")
      "title": "Load axiom's module",
      "file": managedPath,
      "text": includeLines,
      "place": "start",
      "comment": "#",
      "accept": "^\\s*include\\s+.*axiom/sway\\.conf",
      // I18n.tr("Adds the lines at the top, so your own settings after them win over axiom's.")
      "note": "Adds the lines at the top, so your own settings after them win over axiom's."
    })
  readonly property var autostartTarget: ({
      // I18n.tr("Start axiom")
      "title": "Start axiom",
      "file": managedPath,
      "text": autostartLines,
      "place": "end",
      "comment": "#",
      "accept": "(qs|quickshell) .*(-c +['\"]?axiom|-p +['\"]?\\S*axiom)",
      // I18n.tr("Adds the line at the end: sway starts axiom with every session.")
      "note": "Adds the line at the end: sway starts axiom with every session."
    })

  readonly property string shellCommand: Paths.shellCommand
  readonly property string startCommand: `${shellCommand} -n`
  readonly property string _header: "# Generated by axiom"

  // Why a file mode isn't in effect (CompositorConfigManager.problem)
  readonly property string notIncludedProblem: `Compositor mode is "included", but your sway config doesn't include ${includePath}; add:\n${includeLines}`
  readonly property string notManagedProblem: `Compositor mode is "managed", but ${managedPath} isn't loaded`
  readonly property string blockedProblem: `Compositor mode is "managed", but axiom doesn't manage sway's config yet; use "included" instead. Applying axiom's layer at runtime meanwhile.`

  // --- The layer as sway commands (SwayConf) ---

  // What the bind commands need from outside the bind
  readonly property var _bindCtx: ({
      "shellCommand": shellCommand,
      "terminal": Apps.terminalCommand,
      "fileManager": Apps.fileManagerCommand,
      "browser": Apps.browserCommand
    })

  // Whether a configured bind has everything it needs to be bound
  function isComplete(bind) {
    return SwayConf.isComplete(bind, _bindCtx);
  }

  function _inputLines(spec, live) {
    return SwayConf.inputLines(spec.input, ConfigManager.configSchema?.properties?.Input, live);
  }

  // The included file, from `spec` (CompositorConfigManager.spec(true))
  function moduleText(spec) {
    return SwayConf.moduleText({
      "header": _header,
      "includeLines": includeLines,
      "binds": SwayConf.bindLines(KeybindsConfig.binds, _bindCtx),
      "look": SwayConf.lookLines(spec.look, false),
      "input": _inputLines(spec, false)
    });
  }

  // Managed mode isn't written yet (claim() blocks)
  function managedText(spec) {
    return "";
  }

  // The included file once axiom isn't in that mode
  readonly property string emptyModuleText: SwayConf.emptyModuleText(_header)

  // Everything else the layer is made of (CompositorConfigManager re-applies
  // the layer when it changes)
  readonly property string inputsKey: [Apps.terminalCommand, Apps.fileManagerCommand, Apps.browserCommand].join("|")

  // --- At runtime ---

  // The look and the input as commands sent now, from `spec`
  // (CompositorConfigManager.spec(false))
  function liveLines(spec) {
    SwayManager.setLiveGaps(spec.look.gaps);
    return SwayConf.lookLines(spec.look, true).concat(_inputLines(spec, true));
  }

  // CompositorConfigManager's: the live lines, noting which parts they
  // apply. The runtime layer sends them with the rest.
  property var liveLinesHook: () => []

  function runLive(lines) {
    SwayManager.runCommands(lines);
  }

  function setCursor(theme, size) {
    SwayManager.runCommands([SwayConf.cursorLine(theme, size)]);
  }

  // Calls back with the binds the user's own sway config holds
  // (SwayConf.configBinds; its includes in, axiom's file left out), or null
  function readUserBinds(callback) {
    CommandManager.run([Paths.scriptsPath + "sway_config_text.py", "--skip", root.includePath], (code, out, err) => {
      if (code !== 0) {
        console.warn("[SwayConfigWriter] Can't read your sway config:", String(err).trim());
        callback(null);
        return;
      }
      callback(SwayConf.configBinds(out));
    });
  }

  SwayRuntimeLayer {
    id: runtime
    bindCtx: root._bindCtx
    lookLines: () => root.liveLinesHook()
    readUserBinds: callback => root.readUserBinds(callback)
  }

  // The runtime layer (detached, and the fallback of the file modes)
  function runtimeApply() {
    _runtimeOn = true;
    runtime.apply();
  }

  // Takes the runtime layer's binds out (the file is loaded now)
  function runtimeClear() {
    _runtimeOn = false;
    runtime.clear();
  }

  property bool _runtimeOn: false

  // Sway reloaded its config, dropping the runtime layer
  function noteReload() {
    runtime.noteReload();
  }

  // Calls back with whether the file is in effect: only it defines the
  // marker mode (SwayConf.includedMode)
  function checkLoaded(callback) {
    SwayIpcManager.json("get_binding_modes", modes => callback(Array.isArray(modes) && modes.includes(SwayConf.includedMode)));
  }

  // Reloads sway's config (it doesn't watch the files it includes)
  function reload(callback) {
    SwayIpcManager.command("reload", () => callback?.());
  }

  // --- The binds in effect (SwayManager.withMainBinds) ---

  // Calls back with the user's binds and axiom's in effect (BindKeys'
  // entries), or null: axiom's are those the runtime layer bound, or all
  // of them while the file is loaded
  function withEntries(callback) {
    root.readUserBinds(entries => {
      if (!entries) {
        callback(null);
        return;
      }
      const ours = root._runtimeOn ? runtime.applied : KeybindsConfig.binds;
      callback(entries.filter(entry => entry.submap === "").concat(SwayConf.bindEntries(ours, root._bindCtx)));
    });
  }

  // --- Managed takeover: not yet on sway ---

  signal claimed(string adopted)
  signal blocked
  signal released(string result)

  readonly property string managedCheck: "blocked"
  readonly property string managedBlockedBy: ""
  readonly property string managedBlockedRepo: ""
  readonly property var monitorConflicts: []

  function checkManaged() {
  }

  function claim() {
    root.blocked();
  }

  function release() {
    root.released("none");
  }

  function findMonitorConflicts() {
  }

  function clearConflicts() {
  }

  // --- Moving the user's binds into axiom: not yet on sway ---

  readonly property bool merging: false
  readonly property var lastMerge: null
  readonly property int mergeable: 0
  signal bindsMerged(var binds)

  function mergeUserBinds(only) {
  }

  function previewMerge() {
  }
}
