pragma Singleton
pragma ComponentBehavior: Bound

import QtQuick
import Quickshell

import qs.config
import qs.components.methods

/*
 * Sway's config writer (docs/dev/compositor/config-modes.md), reached as
 * SwayManager.configWriter by CompositorConfigManager, which drives the
 * modes. Turns axiom's layer (binds, the window look, input) into sway's
 * commands (SwayConf):
 *   detached  sent at runtime (SwayRuntimeLayer); binds on keys the user's
 *             config already binds are skipped
 *   included  the file at $XDG_STATE_HOME/axiom/sway.conf, which the user's
 *             sway config includes (includeLines)
 *   managed   ~/.config/sway/config itself, with the WindowBehaviour and
 *             Sway sections' options and the session, including
 *             ~/.config/sway/user/* after it (ConfigTakeover)
 * The file modes write the monitor profile for what's connected (a sway
 * reload resets the outputs to what the config says); MonitorManager
 * applies it at runtime too, at start, on every hotplug, and after a
 * reload while no file of axiom's is loaded.
 */
Singleton {
  id: root

  // Configured keys the runtime layer skipped because the user's sway
  // config already binds them
  readonly property var skippedKeys: runtime.skippedKeys

  // --- Files and the lines a user's config needs ---

  readonly property string configDir: Paths.swayPath
  readonly property string includePath: Paths.userStatePath + "sway.conf"
  readonly property string managedPath: Paths.swayPath + "config"
  readonly property string userDir: Paths.swayPath + "user"
  readonly property string userFiles: userDir + "/*"
  // What the user's sway config needs for the included mode
  readonly property string includeLines: `include ${SwayConf.quote(includePath)}`
  // What a sway config needs to start axiom with sway, for the detached and
  // included modes. -n (--no-duplicate) exits at once if axiom already
  // runs, so a reload can't start another copy.
  readonly property string autostartLines: `exec ${startCommand}`

  // The lines above as integration_hookup.py targets in the user's sway
  // config (IntegrationHookupManager's "compositorInclude" and
  // "compositorAutostart"): the include first, so what follows overrides
  // it, and the autostart last. Any line starting axiom counts.
  readonly property var includeTarget: ({
      // I18n.tr("Load axiom's module")
      "title": "Load axiom's module",
      "file": managedPath,
      "text": includeLines,
      "place": "start",
      "comment": "#",
      "accept": "^\\s*include\\s+.*axiom/sway\\.conf",
      // I18n.tr("Adds the lines at the top, so your own settings after them win over axiom's.")
      "note": "Adds the lines at the top, so your own settings after them win over axiom's."
    })
  readonly property var autostartTarget: ({
      // I18n.tr("Start axiom")
      "title": "Start axiom",
      "file": managedPath,
      "text": autostartLines,
      "place": "end",
      "comment": "#",
      "accept": "(qs|quickshell) .*(-c +['\"]?axiom|-p +['\"]?\\S*axiom)",
      // I18n.tr("Adds the line at the end: sway starts axiom with every session.")
      "note": "Adds the line at the end: sway starts axiom with every session."
    })

  readonly property string shellCommand: Paths.shellCommand
  readonly property string startCommand: `${shellCommand} -n`
  readonly property string _header: "# Generated by axiom"

  // Why a file mode isn't in effect (CompositorConfigManager.problem)
  readonly property string notIncludedProblem: `Compositor mode is "included", but your sway config doesn't include ${includePath}; add:\n${includeLines}`
  readonly property string notManagedProblem: `Compositor mode is "managed", but ${managedPath} isn't loaded`
  readonly property string blockedProblem: `Compositor mode is "managed", but ${Paths.swayPath} is a symlink or in a git repository, so axiom won't take it over; use "included" instead. Applying axiom's layer at runtime meanwhile.`

  // --- The layer as sway commands (SwayConf) ---

  // What the bind commands need from outside the bind
  readonly property var _bindCtx: ({
      "shellCommand": shellCommand,
      "terminal": Apps.terminalCommand,
      "fileManager": Apps.fileManagerCommand,
      "browser": Apps.browserCommand
    })

  // Whether a configured bind has everything it needs to be bound
  function isComplete(bind) {
    return SwayConf.isComplete(bind, _bindCtx);
  }

  function _inputLines(spec, live) {
    return SwayConf.inputLines(spec.input, ConfigManager.configSchema?.properties?.Input, live);
  }

  // The saved monitor profile for what's connected (MonitorLayout.
  // matchProfile, as MonitorManager applies it), as `output` lines: a sway
  // reload sets the outputs as its config says, dropping what was set at
  // runtime. null until MonitorManager has read the outputs, when the file
  // keeps what it says (so a start doesn't write them out and back).
  readonly property var _outputLines: {
    if (!MonitorManager.outputsRead)
      return null;
    const outputs = MonitorManager.outputs;
    const profiles = MonitorsConfig.profiles;
    const index = MonitorLayout.matchProfile(profiles, outputs.filter(output => !output.disabled));
    return index < 0 ? [] : SwayConf.outputLines(profiles[index].outputs.filter(rule => MonitorLayout.find(rule.output, outputs) !== null));
  }

  function _outputLinesIn(path) {
    return _outputLines ?? SwayConf.fileOutputLines(FileManager.read(path));
  }

  function _moduleText(spec, path) {
    return SwayConf.moduleText({
      "header": _header,
      "includeLines": includeLines,
      "binds": SwayConf.bindLines(KeybindsConfig.binds, _bindCtx),
      "look": SwayConf.lookLines(spec.look, false),
      "input": _inputLines(spec, false),
      "outputs": _outputLinesIn(path)
    });
  }

  // The included file, from `spec` (CompositorConfigManager.spec(true))
  function moduleText(spec) {
    return _moduleText(spec, includePath);
  }

  // The managed sway config, from `spec` as for moduleText
  function managedText(spec) {
    // reads: WindowBehaviour.*, Sway.*, Session.*
    const schema = ConfigManager.configSchema?.properties;
    return SwayConf.managedText(_moduleText(spec, managedPath), {
      "header": _header,
      "userDir": userDir,
      "options": SwayConf.optionLines(schema?.WindowBehaviour, WindowBehaviourConfig.behaviour).concat(SwayConf.optionLines(schema?.Sway, SwayConfig.options)),
      "env": CompositorLayer.sessionEnv(SessionConfig.session, spec.input.cursor),
      "start": {
        "command": startCommand,
        "idle": Idle.enabled,
        "polkit": PolkitConfig.enabled
      },
      "autostart": SessionConfig.session.autostart,
      "isAgent": command => PolkitAgents.isAgentCommand(command)
    });
  }

  // The config leaving managed gives back when the takeover set nothing
  // aside: it starts axiom (and includes its module in included mode)
  function releasedText(mode) {
    return SwayConf.releasedText(userDir, (mode === "included" ? includeLines + "\n" : "") + autostartLines);
  }

  // The included file once axiom isn't in that mode
  readonly property string emptyModuleText: SwayConf.emptyModuleText(_header)

  // Everything else the layer is made of (CompositorConfigManager re-applies
  // the layer when it changes)
  readonly property string inputsKey: [WindowBehaviourConfig._behaviourJson, SwayConfig._optionsJson, Apps.terminalCommand, Apps.fileManagerCommand, Apps.browserCommand, Idle.enabled, PolkitConfig.enabled, JSON.stringify(_outputLines)].join("|")

  // --- At runtime ---

  // The look and the input as commands sent now, from `spec`
  // (CompositorConfigManager.spec(false)).
  // SwayFX's part (rounded corners, its blur, shadows, dimming and the
  // blur behind axiom's surfaces) only ever goes this way, never into a
  // file, so the config still loads in plain sway
  function liveLines(spec) {
    SwayManager.setLiveLook(spec.look);
    const fx = SwayManager.fx ? SwayConf.fxLines(spec.look, spec.surfaces) : [];
    return SwayConf.lookLines(spec.look, true).concat(fx, _inputLines(spec, true));
  }

  // CompositorConfigManager's: the live lines, noting which parts they
  // apply. The runtime layer sends them with the rest.
  property var liveLinesHook: () => []

  // (sway sends no event for a gap change: the windows are read again)
  function runLive(lines) {
    SwayManager.runCommands(lines, () => SwayManager.refresh());
  }

  // `cursor`: CompositorLayer.input()'s
  function setCursor(cursor) {
    SwayManager.runCommands([SwayConf.cursorLine(cursor.xcursor, cursor.size)]);
  }

  // Calls back with the binds the user's own sway config holds
  // (SwayConf.configBinds; its includes in, axiom's files left out: the
  // included module, and the managed config's own lines), or null
  function readUserBinds(callback) {
    CommandManager.run([Paths.scriptsPath + "sway_config_text.py", "--skip", root.includePath, "--skip-header", root._header], (code, out, err) => {
      if (code !== 0) {
        console.warn("[SwayConfigWriter] Can't read your sway config:", String(err).trim());
        callback(null);
        return;
      }
      callback(SwayConf.configBinds(out));
    });
  }

  SwayRuntimeLayer {
    id: runtime
    bindCtx: root._bindCtx
    lookLines: () => root.liveLinesHook()
    // The user's binds, no context: sway's send needs none
    readBinds: callback => root.readUserBinds(callback)
  }

  // The runtime layer (detached, and the fallback of the file modes)
  function runtimeApply() {
    _runtimeOn = true;
    runtime.apply();
  }

  // Takes the runtime layer's binds out (the file is loaded now)
  function runtimeClear() {
    _runtimeOn = false;
    runtime.clear();
  }

  property bool _runtimeOn: false

  // Sway reloaded its config, dropping the runtime layer
  function noteReload() {
    runtime.noteReload();
  }

  // Calls back with whether the file is in effect: only it defines the
  // marker mode (SwayConf.loadedMode)
  function checkLoaded(callback) {
    SwayIpcManager.json("get_binding_modes", modes => callback(Array.isArray(modes) && modes.includes(SwayConf.loadedMode)));
  }

  // Reloads sway's config (it doesn't watch the files it includes)
  function reload(callback) {
    SwayIpcManager.command("reload", () => callback?.());
  }

  // --- The binds in effect (SwayManager.withMainBinds) ---

  // Calls back with the user's binds and axiom's in effect (BindKeys'
  // entries), or null: axiom's are those the runtime layer bound, or all
  // of them while the file is loaded
  function withEntries(callback) {
    root.readUserBinds(entries => {
      if (!entries) {
        callback(null);
        return;
      }
      const ours = root._runtimeOn ? runtime.applied : KeybindsConfig.binds;
      callback(entries.filter(entry => entry.submap === "").concat(SwayConf.bindEntries(ours, root._bindCtx)));
    });
  }

  // --- Managed takeover: ConfigTakeover, on claim_sway.sh ---

  // The takeover of the config is done (`adopted`: the file name the
  // previous one went to in user/, or "")
  signal claimed(string adopted)
  // It won't take over (blockedProblem)
  signal blocked
  // Leaving managed is done: "restored" | "written" | …
  signal released(string result)

  ConfigTakeover {
    id: takeover
    mode: CompositorConfig.mode
    script: Paths.scriptsPath + "claim_sway.sh"
    configDir: Paths.swayPath
    managedPath: root.managedPath
    userDir: root.userDir
    userFiles: root.userFiles
    header: root._header
    releasedText: root.releasedText(CompositorConfig.mode)
    monitorPattern: "^[[:space:]]*output[[:space:]]+[^[:space:]]+[[:space:]]+(mode|res|resolution|pos|position|scale|transform|enable|disable|power)"
    logTag: "SwayConfigWriter"
    onClaimed: (result, adopted) => root.claimed(adopted)
    onBlocked: root.blocked()
    onReleased: result => root.released(result)
  }

  // What switching to managed would do (ConfigTakeover.managedCheck)
  readonly property alias managedCheck: takeover.managedCheck
  readonly property alias managedBlockedBy: takeover.managedBlockedBy
  readonly property alias managedBlockedRepo: takeover.managedBlockedRepo
  // Managed mode: the files in user/ that set outputs themselves
  readonly property alias monitorConflicts: takeover.monitorConflicts

  // `callback` (optional) gets managedCheck once known
  function checkManaged(callback) {
    takeover.checkManaged(callback);
  }

  function claim() {
    takeover.claim();
    takeover.findMonitorConflicts();
  }

  function release() {
    takeover.release();
  }

  function findMonitorConflicts() {
    takeover.findMonitorConflicts();
  }

  function clearConflicts() {
    takeover.clearConflicts();
  }

  // --- Moving the user's binds into axiom: UserBindMerge, on merge_sway_binds.py ---

  UserBindMerge {
    id: bindMerge
    enabled: CompositorConfig.mode === "managed"
    script: Paths.scriptsPath + "merge_sway_binds.py"
    configDir: Paths.swayPath
    userDir: root.userDir
    logTag: "SwayConfigWriter"
    onBindsMerged: binds => root.bindsMerged(binds)
  }

  readonly property alias merging: bindMerge.merging
  // The last merge (UserBindMerge.lastMerge), or null
  readonly property alias lastMerge: bindMerge.lastMerge
  // How many binds a Merge of all of user/ would move; -1 until looked
  readonly property alias mergeable: bindMerge.mergeable
  // The binds a merge moved in for good
  signal bindsMerged(var binds)

  // `only`: one file name in user/ (the adopted one), else all of them
  function mergeUserBinds(only) {
    bindMerge.mergeUserBinds(only);
  }

  // Counts what a Merge would move, changing nothing (`mergeable`)
  function previewMerge() {
    bindMerge.previewMerge();
  }
}
