pragma Singleton
pragma ComponentBehavior: Bound

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland

import qs.config
import qs.components.methods

/*
 * Sets Hyprland up for axiom (the Hyprland section, HyprlandConfig.mode).
 * One Lua "layer" (binds, required settings, the window look, blur,
 * monitor profiles, strips) reaches
 * Hyprland in one of three ways:
 *   detached  evaluated at runtime (HyprlandRuntimeLayer), again after every config
 *             reload, which drops it; binds on keys already taken are skipped
 *   included  written to $XDG_STATE_HOME/axiom/hyprland.lua, a module the
 *             user's hyprland.lua loads (includeLines)
 *   managed   written into ~/.config/hypr/hyprland.lua itself, with the
 *             Managed config, loading ~/.config/hypr/user/*.lua after it
 * Whenever the file isn't loaded (included but the lines are missing, or a
 * managed takeover refused), the runtime layer is applied instead, so axiom
 * still works, and `problem` says why.
 * The window look (WindowLookConfig.look: themed borders, axiom's shape,
 * gaps, Hyprland's blur, window opacity) and the blur behind axiom's
 * surfaces are also evaluated after every config reload in each mode, so
 * they win over the user's own config while they're on (_applyLook).
 */
Singleton {
  id: root

  readonly property string mode: HyprlandConfig.mode
  // Why the chosen mode isn't in effect, or ""
  readonly property string problem: _problem
  property string _problem: ""
  // "runtime" (detached), "loaded" (the file is in effect), "fallback"
  // (it isn't: see `problem`) or "pending" (still checking)
  readonly property string status: mode === "detached" ? "runtime" : _problem !== "" ? "fallback" : _loaded ? "loaded" : "pending"
  property bool _loaded: false
  // Configured keys the runtime layer skipped because Hyprland's config
  // already binds them
  readonly property alias skippedKeys: runtime.skippedKeys
  // A problem belongs to the mode it was found in
  onModeChanged: {
    _problem = "";
    _loaded = false;
    takeover.clearConflicts();
  }

  readonly property string includePath: Paths.userStatePath + "hyprland.lua"
  readonly property string managedPath: Paths.hyprlandPath + "hyprland.lua"
  readonly property string userDir: Paths.hyprlandPath + "user"
  // What the user's hyprland.lua needs for the included mode
  readonly property string includeLines: `local ok, axiom = pcall(dofile, ${_lua(includePath)})\nif ok then axiom.setup() end`

  // What a hyprland.lua needs to start axiom with Hyprland, for the
  // detached and included modes (managed starts it itself). One line, marked
  // as install.sh's is, so applying it never splits a block.
  readonly property string autostartLines: `hl.on("hyprland.start", function() hl.exec_cmd(${_lua(startCommand)}) end) -- axiom`

  // The lines above as integration_hookup.py targets in the user's
  // hyprland.lua (IntegrationHookupManager's "hyprlandInclude" and
  // "hyprlandAutostart"): the include goes first, so what follows overrides
  // it, and the autostart last. Any line starting axiom counts, install.sh's
  // `qs -c axiom` included.
  readonly property var includeTarget: ({
      // I18n.tr("Load axiom's module")
      "title": "Load axiom's module",
      "file": managedPath,
      "text": includeLines,
      "place": "start",
      "comment": "--",
      "accept": "axiom\\.setup\\(",
      // I18n.tr("Adds the lines at the top, so your own settings after them win over axiom's.")
      "note": "Adds the lines at the top, so your own settings after them win over axiom's."
    })
  readonly property var autostartTarget: ({
      // I18n.tr("Start axiom")
      "title": "Start axiom",
      "file": managedPath,
      "text": autostartLines,
      "place": "end",
      "comment": "--",
      "accept": "(qs|quickshell) .*(-c +['\"]?axiom|-p +['\"]?\\S*axiom)",
      // I18n.tr("Adds the line at the end: Hyprland starts axiom with every session.")
      "note": "Adds the line at the end: Hyprland starts axiom with every session."
    })

  // How Hyprland and its binds start or call axiom (Paths.shellCommand)
  readonly property string shellCommand: Paths.shellCommand
  // Starting it: -n (--no-duplicate) exits at once if axiom already runs,
  // so a second autostart line or a reloaded hyprland.lua can't start
  // another copy
  readonly property string startCommand: `${shellCommand} -n`
  readonly property string _header: "-- Generated by axiom"

  // --- The Lua layer (HyprConfigLua; what each bind action is, the
  // Keybinds page reads from BindActions directly) ---

  // What the bind Lua needs from outside the bind
  readonly property var _bindCtx: ({
      "shellCommand": shellCommand,
      "terminal": Apps.terminalCommand,
      "fileManager": Apps.fileManagerCommand,
      "browser": Apps.browserCommand
    })

  // A Lua string literal
  function _lua(text) {
    return HyprLua.string(text);
  }

  // Whether a configured bind has everything it needs to be bound
  function isComplete(bind) {
    return HyprConfigLua.bindLua(bind, _bindCtx) !== "";
  }

  // Whether axiom's surfaces blur: as saved for a file, and at runtime as
  // now (BlurManager.active, paused over a fullscreen window), evaluated
  // over the file after every reload
  function _surfacesBlur(forFile) {
    return forFile === true ? Appearance.blur : BlurManager.active;
  }

  function _lookLua(forFile) {
    return HyprLua.lookLua(WindowLookConfig.look, ConfigManager.configSchema?.properties?.WindowLook, HyprConfigLua.hex(Theme.borderFocus), HyprConfigLua.hex(Theme.border), Appearance.borderWidth, Appearance.borderRadius, _surfacesBlur(forFile));
  }

  // The blur behind axiom's surfaces, its rules written on or off
  // (HyprLua.blurLua)
  function _blurLua(forFile) {
    return HyprLua.blurLua({
      "on": _surfacesBlur(forFile),
      "threshold": Appearance.blurThreshold,
      "throughWindows": Appearance.blurThroughWindows,
      "backdrops": Appearance.blurBackdrops
    });
  }

  function _stripsLua() {
    return HyprLua.stripsLua(WorkspacesConfig.strips, ConfigManager.configSchema?.properties?.Workspaces, WorkspacesConfig.stripOptions);
  }

  // The included file: a module whose setup() applies what's enabled
  function moduleLua() {
    return HyprConfigLua.moduleLua({
      "header": _header,
      "includeLines": includeLines,
      "requiredSettings": HyprlandConfig.requiredSettings,
      "binds": HyprConfigLua.bindLines(HyprlandConfig.binds, _bindCtx),
      "look": _lookLua(true),
      "blur": _blurLua(true),
      "layers": HyprLua.layerRulesLua(),
      "monitors": HyprLua.monitorsLua(HyprlandConfig.monitorProfiles),
      "strips": _stripsLua()
    });
  }

  // The shell's motion (Look & Feel → Motion), for the managed animations
  readonly property var _motion: ({
      "fast": Appearance.animFast,
      "normal": Appearance.animNormal,
      "slow": Appearance.animSlow,
      "enabled": Appearance.animations
    })

  // The managed hyprland.lua
  function managedLua() {
    // reads: Hyprland.managed.*
    return HyprConfigLua.managedLua(moduleLua(), HyprlandConfig.managed, {
      "header": _header,
      "userDir": userDir,
      "schema": ConfigManager.configSchema?.properties?.Hyprland?.properties?.managed,
      "resolveHex": name => HyprConfigLua.hex(Theme.resolveColor(name)),
      "lookShape": WindowLookConfig.look.shape,
      "motion": _motion,
      "start": {
        "command": startCommand,
        "idle": Idle.enabled,
        "polkit": PolkitConfig.enabled
      }
    });
  }

  // The hyprland.lua leaving managed gives back when the takeover set
  // nothing aside (claim_hyprland.sh release), starting axiom (and loading
  // its module in included mode)
  function releasedLua() {
    return HyprConfigLua.releasedLua(userDir, (mode === "included" ? includeLines + "\n" : "") + autostartLines);
  }

  // --- Runtime (detached, and the fallback): HyprlandRuntimeLayer ---

  HyprlandRuntimeLayer {
    id: runtime
    bindCtx: root._bindCtx
    lookLines: () => root._runtimeLookLua()
    // Strips once per Hyprland load (HyprLua.stripsRuntimeLua)
    stripsLines: () => HyprLua.stripsRuntimeLua(root._stripsLua(), WorkspacesConfig._stripsJson)
  }

  // --- Files (included, managed) ---

  // Writes `text` to `path` unless it's already there; then reloads
  // Hyprland, since it doesn't watch files a config loads
  function _writeIfChanged(path, text) {
    if (FileManager.read(path) === text) {
      _checkLoaded();
      return;
    }
    CommandManager.run(["mkdir", "-p", path.replace(/\/[^/]*$/, "")], code => {
      if (code !== 0) {
        console.warn("[HyprlandConfigManager] Could not create the folder for", path);
        return;
      }
      root._writeFile(writer, path, text);
    });
  }

  // After a (re)load: is the file in effect? If not, the runtime layer
  // stands in for it. Hyprland answers "ok" when the file's marker is set
  // in its Lua state
  function _checkLoaded() {
    if (_checking)
      return;
    _checking = true;
    HyprlandIpcManager.evalLua("if not AXIOM_INCLUDED then error('axiom: not loaded') end", reply => {
      root._checking = false;
      if (root.mode === "detached")
        return;
      if (reply === "ok") {
        root._problem = "";
        root._loaded = true;
        runtime.clear();
        return;
      }
      if (root.mode === "included")
        root._warnOnce(`Hyprland mode is "included", but hyprland.lua doesn't load ${root.includePath}; add:\n${root.includeLines}`);
      else if (root._problem === "")
        root._warnOnce(`Hyprland mode is "managed", but ${root.managedPath} isn't loaded (see hyprctl configerrors)`);
      runtime.apply();
    });
  }

  property bool _checking: false

  function _warnOnce(message) {
    if (_problem === message)
      return;
    _problem = message;
    console.warn("[HyprlandConfigManager]", message);
  }

  // Writes `text` to `path` through `view`, reading the file first: a
  // FileView skips setText of the text it last read or wrote, which the
  // file may no longer hold (release replaced it, or the user edited it)
  function _writeFile(view, path, text) {
    view.path = "";
    view.path = path;
    view.setText(text);
  }

  FileView {
    id: writer
    atomicWrites: true
    blockLoading: true
    printErrors: false
    onSaved: root._reload()
    onSaveFailed: error => console.warn("[HyprlandConfigManager] Could not write", writer.path, error)
  }

  // The included module emptied (_emptyModule), apart from `writer`, which
  // a takeover may be using at the same time
  FileView {
    id: moduleWriter
    atomicWrites: true
    blockLoading: true
    printErrors: false
    onSaved: root._reload()
    onSaveFailed: error => console.warn("[HyprlandConfigManager] Could not write", moduleWriter.path, error)
  }

  // Reloads Hyprland, again once the running reload ends if one is asked
  // for meanwhile (a file written then would otherwise be missed)
  function _reload() {
    if (_reloading) {
      _reloadAgain = true;
      return;
    }
    _reloading = true;
    HyprlandIpcManager.request("reload", () => {
      root._reloading = false;
      if (root._reloadAgain) {
        root._reloadAgain = false;
        root._reload();
      }
    });
  }

  property bool _reloading: false
  property bool _reloadAgain: false

  // --- Managed takeover: HyprlandTakeover ---

  HyprlandTakeover {
    id: takeover
    mode: root.mode
    hyprlandPath: Paths.hyprlandPath
    managedPath: root.managedPath
    userDir: root.userDir
    header: root._header
    releasedLua: root.releasedLua()
    onClaimed: (result, adopted) => {
      root._writeIfChanged(root.managedPath, root.managedLua());
      // The adopted config's binds would fight axiom's: they move in. Only
      // that file's: the user's other files in user/ are left to the
      // Keybinds page's Merge
      if (adopted)
        root.mergeUserBinds(adopted);
    }
    onBlocked: {
      root._warnOnce(`Hyprland mode is "managed", but ${Paths.hyprlandPath} is a symlink or in a git repository, so axiom won't take it over; use "included" instead. Applying axiom's layer at runtime meanwhile.`);
      runtime.apply();
    }
    onReleased: result => {
      root._releasing = false;
      // A reload brings the given-back config in, and with it the runtime
      // layer (configreloaded); without one, the runtime layer goes on now
      if (result === "restored" || result === "written")
        root._reload();
      else if (root.mode === "detached")
        runtime.apply();
    }
  }

  // What switching to managed would do (HyprlandTakeover.managedCheck)
  readonly property alias managedCheck: takeover.managedCheck
  readonly property alias managedBlockedBy: takeover.managedBlockedBy
  readonly property alias managedBlockedRepo: takeover.managedBlockedRepo
  // Managed mode: the user/*.lua files that set monitors themselves
  readonly property alias monitorConflicts: takeover.monitorConflicts

  function checkManaged() {
    takeover.checkManaged();
  }

  // --- Moving the user's binds into axiom: HyprlandBindMerge ---

  HyprlandBindMerge {
    id: bindMerge
    enabled: root.mode === "managed"
    hyprlandPath: Paths.hyprlandPath
    userDir: root.userDir
    onBindsMerged: binds => root.bindsMerged(binds)
  }

  readonly property alias merging: bindMerge.merging
  // The last merge (HyprlandBindMerge.lastMerge), or null
  readonly property alias lastMerge: bindMerge.lastMerge
  // How many binds a Merge of all of user/ would move; -1 until looked
  readonly property alias mergeable: bindMerge.mergeable
  // The binds a merge moved in for good (KeybindManager adds them to a
  // draft with unsaved edits)
  signal bindsMerged(var binds)

  // `only`: one file name in user/ (the adopted one), else all of them
  function mergeUserBinds(only) {
    bindMerge.mergeUserBinds(only);
  }

  // Counts what a Merge would move, changing nothing (`mergeable`)
  function previewMerge() {
    bindMerge.previewMerge();
  }

  // --- For the settings page ---

  function copyIncludeLines() {
    ClipboardManager.copyText(includeLines);
  }

  function openConfigDir() {
    Quickshell.execDetached(["xdg-open", Paths.hyprlandPath]);
  }

  // --- Driving it ---

  // Whether axiom runs under Hyprland, so its config is axiom's to write
  readonly property bool live: CompositorManager.supports.configModes === true

  function apply() {
    // Only under Hyprland: elsewhere nothing here may touch its config
    if (!root.live)
      return;
    // Detached, the reload's configreloaded applies the layer again. The
    // file modes go on: their configreloaded doesn't call apply(), so
    // returning would drop a mode switch or a rewrite made with it.
    if (_undoLook() && mode === "detached")
      return;
    if (_appliedMode !== "" && _appliedMode !== mode)
      _leave(_appliedMode);
    _appliedMode = mode;
    if (mode === "included") {
      _writeIfChanged(includePath, moduleLua());
    } else if (mode === "managed") {
      takeover.claim();
      takeover.findMonitorConflicts();
    } else {
      _problem = "";
      // Not over the managed layer a release is about to take out: its
      // binds would read as the user's
      if (!_releasing)
        runtime.apply();
    }
  }

  // --- The window look, over the user's config in every mode ---

  // The look's parts last evaluated at runtime ("borders,gaps"), until a
  // config reload drops them. Kept across QML reloads, as Hyprland keeps
  // them.
  PersistentProperties {
    id: _lookState
    reloadableId: "axiomHyprlandLook"
    property string applied: ""
  }

  // After a config reload in the file modes: the module set the look before
  // the user's own lines, so it's evaluated again to win over them. And in
  // every mode as the look or the blur changes (_liveDebounce).
  function _applyLook() {
    if (!root.live)
      return;
    HyprlandManager.runLua(_runtimeLookLua().join("\n"));
    HyprlandManager.refreshOptions();
  }

  // The look and the blur as evaluated at runtime now, noting which look
  // parts that applies (the runtime layer evaluates them too)
  function _runtimeLookLua() {
    _lookState.applied = HyprLua.lookParts(WindowLookConfig.look).join(",");
    return _lookLua(false).concat(_blurLua(false));
  }

  // The look's parts evaluated since the last reload that are off now
  function _droppedLookParts() {
    const now = HyprLua.lookParts(WindowLookConfig.look);
    return _lookState.applied.split(",").filter(part => part !== "" && !now.includes(part));
  }

  // A runtime eval can't take a setting back: a part turned off since it
  // was evaluated reloads Hyprland's config, whose configreloaded applies
  // the rest again. True when it reloaded.
  function _undoLook() {
    const dropped = _droppedLookParts();
    if (dropped.length === 0)
      return false;
    _lookState.applied = "";
    // The file modes rewrite their file, which reloads anyway, unless it
    // never held the part (only evaluated at runtime since its last write)
    if (mode !== "detached" && _appliedMode === mode && status === "loaded" && FileManager.read(mode === "managed" ? managedPath : includePath) !== (mode === "managed" ? managedLua() : moduleLua()))
      return false;
    console.log(`[HyprlandConfigManager] Window look turned off (${dropped.join(", ")}); reloading Hyprland's config to take it back`);
    _reload();
    return true;
  }

  // The mode apply() last set up, "" before the first: only a switch made
  // while axiom runs gives anything back, never a load
  property string _appliedMode: ""
  // While claim_hyprland.sh release runs (detached waits for it)
  property bool _releasing: false

  // Gives back what `previous` took (as the takeover settings do, its own
  // card switching it): leaving managed, the hyprland.lua it claimed
  // (claim_hyprland.sh release); leaving included (or managed, whose
  // restored config may load it), the module, which then does nothing.
  // Otherwise the old layer stays in Hyprland's config, and the runtime
  // layer, which only adds, can't undo it (a strip it set stays a strip).
  function _leave(previous) {
    if (mode !== "included")
      _emptyModule();
    if (previous === "managed") {
      _releasing = true;
      takeover.release();
    }
  }

  // The included module once axiom isn't in that mode (every part a no-op)
  readonly property string _emptyModuleLua: HyprConfigLua.emptyModuleLua(_header)

  function _emptyModule() {
    const current = FileManager.read(includePath);
    if (!current || current === _emptyModuleLua)
      return;
    _writeFile(moduleWriter, includePath, _emptyModuleLua);
  }

  // Everything the layer is made of but the look and the blur; a change
  // re-applies it (in the file modes, rewriting the file, which reloads
  // Hyprland)
  readonly property string _inputs: [mode, HyprlandConfig._bindsJson, HyprlandConfig._monitorsJson, HyprlandConfig._managedJson, WorkspacesConfig._stripsJson, HyprlandConfig.requiredSettings, Theme.baseColorNames.map(name => Theme.resolveColor(name)).join(","), Appearance.animFast, Appearance.animations, Apps.terminalCommand, Apps.fileManagerCommand, Apps.browserCommand, Idle.enabled, PolkitConfig.enabled].join("|")
  on_InputsChanged: _debounce.restart()

  // The window look and the blur behind axiom (paused over a fullscreen
  // window too). A change is only evaluated at runtime, in every mode: a
  // Hyprland reload on every step of a setting stalls the desktop, and
  // detached, re-applying the whole layer redoes every bind. The file
  // holds them as of its last write, and _applyLook evaluates the current
  // ones over it after every reload. Turning a look part off goes through
  // apply(), since an eval can't take a setting back.
  readonly property string _liveInputs: [WindowLookConfig._lookJson, Appearance.blur, BlurManager.active, Appearance.blurBackdrops, Appearance.blurThroughWindows, Theme.borderFocus, Theme.border, Appearance.borderRadius, Appearance.borderWidth].join("|")
  on_LiveInputsChanged: _liveDebounce.restart()

  property Timer _liveDebounce: Timer {
    interval: 300
    onTriggered: {
      if (!root.live)
        return;
      if (root._appliedMode !== root.mode || root._droppedLookParts().length > 0)
        root.apply();
      else
        root._applyLook();
    }
  }

  property Timer _debounce: Timer {
    interval: 300
    onTriggered: root.apply()
  }

  Component.onCompleted: _debounce.restart()

  // Only under Hyprland: other services read this one's paths and state
  // (IntegrationHookupManager, KeybindManager), so it exists under any
  // compositor, and touching `Hyprland` there would try to connect to it
  Connections {
    target: root.live ? Hyprland : null

    function onRawEvent(event) {
      if (event.name !== "configreloaded")
        return;
      // A reload drops runtime binds, rules and the look
      runtime.noteReload();
      _lookState.applied = "";
      if (root.mode === "detached") {
        root._debounce.restart();
      } else {
        root._checkLoaded();
        root._applyLook();
      }
      // Hyprland reloads when a user/*.lua file changes
      if (root.mode === "managed")
        takeover.findMonitorConflicts();
    }
  }
}
