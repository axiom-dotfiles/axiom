pragma Singleton
pragma ComponentBehavior: Bound

import QtQuick
import Quickshell
import Quickshell.Io
import Qt.labs.folderlistmodel

import qs.config
import qs.components.methods

/*
 * niri's config writer (docs/dev/compositor/config-modes.md), reached as
 * NiriManager.configWriter by CompositorConfigManager, which drives the
 * modes. Turns axiom's layer (binds, the window look, input, outputs) into
 * niri's config (NiriConf). niri takes nothing of it at runtime: it lives
 * in files only, which niri reloads by itself as they change
 * (`liveByFile`), each checked with `niri validate` before it's written
 * (`validate`):
 *   detached  the module at $XDG_STATE_HOME/axiom/niri-detached-module.kdl
 *             and a wrapper beside it including the user's config and
 *             then it, which niri loads in place of the user's config
 *             (load-config-file) while axiom runs; the user's files are
 *             never touched
 *   included  the module at $XDG_STATE_HOME/axiom/niri.kdl, which the
 *             user's config includes at its end (includeLines)
 *   managed   ~/.config/niri/config.kdl itself: axiom's binds, the user's
 *             files in ~/.config/niri/user/ (so their binds win), then the
 *             rest of axiom's layer (so its look and settings win, with
 *             the Niri section's options), and the session (ConfigTakeover)
 * The modules leave out binds on keys the user's own config binds
 * (skippedKeys), read from their files (scripts/niri_config.py), so theirs
 * win. Every mode writes the monitor profile for what's connected (as
 * sway's do); MonitorManager applies it at runtime too.
 */
Singleton {
  id: root

  // Configured keys left out because the user's niri config binds them
  readonly property var skippedKeys: _plan.skipped

  // --- Files and the lines a user's config needs ---

  readonly property string configDir: Paths.niriPath
  readonly property string includePath: Paths.userStatePath + "niri.kdl"
  readonly property string managedPath: Paths.niriPath + "config.kdl"
  readonly property string userDir: Paths.niriPath + "user"
  readonly property string userFiles: userDir + "/*.kdl"
  // The detached mode's module and the wrapper loading it after the
  // user's config
  readonly property string detachedPath: Paths.userStatePath + "niri-detached-module.kdl"
  readonly property string wrapperPath: Paths.userStatePath + "niri-detached.kdl"
  // What the user's niri config needs for the included mode, at its end
  readonly property string includeLines: `include ${NiriConf.kdlString(includePath)}`
  // What a niri config needs to start axiom with niri, for the detached and
  // included modes. -n (--no-duplicate) exits at once if axiom already runs.
  readonly property string autostartLines: NiriConf.serialize([NiriConf.node("spawn-sh-at-startup", [startCommand])])

  // The lines above as integration_hookup.py targets in the user's niri
  // config (IntegrationHookupManager's "compositorInclude" and
  // "compositorAutostart"), both at the end: niri keeps the last of a
  // setting, so the module's look wins. Any line starting axiom counts.
  readonly property var includeTarget: ({
      // I18n.tr("Load axiom's module")
      "title": "Load axiom's module",
      "file": _mainConfig,
      "text": includeLines,
      "place": "end",
      "comment": "//",
      "accept": "^\\s*include\\s+.*axiom/niri\\.kdl",
      // I18n.tr("Adds the line at the end, so axiom's look wins; binds on keys your config binds stay yours.")
      "note": "Adds the line at the end, so axiom's look wins; binds on keys your config binds stay yours."
    })
  readonly property var autostartTarget: ({
      // I18n.tr("Start axiom")
      "title": "Start axiom",
      "file": _mainConfig,
      "text": autostartLines,
      "place": "end",
      "comment": "//",
      "accept": "(qs|quickshell) .*(-c +['\"]?axiom|-p +['\"]?\\S*axiom)",
      // I18n.tr("Adds the line at the end: niri starts axiom with every session.")
      "note": "Adds the line at the end: niri starts axiom with every session."
    })

  readonly property string shellCommand: Paths.shellCommand
  readonly property string startCommand: `${shellCommand} -n`
  readonly property string _header: "// Generated by axiom"

  // Why a file mode isn't in effect (CompositorConfigManager.problem)
  readonly property string notIncludedProblem: `Compositor mode is "included", but your niri config doesn't include ${includePath}; add at its end:\n${includeLines}`
  readonly property string notManagedProblem: `Compositor mode is "managed", but ${managedPath} isn't loaded`
  readonly property string blockedProblem: `Compositor mode is "managed", but ${Paths.niriPath} is a symlink or in a git repository, so axiom won't take it over; use "included" instead. Applying axiom's layer at runtime meanwhile.`
  // niri refused axiom's text (`niri validate`): the file was left as it was
  function invalidProblem(error) {
    return `niri refuses the config axiom made, so it wasn't written (a raw bind?):\n${error}`;
  }
  // niri's last load failed: it runs the config before (the user's own
  // files are the likely cause, axiom's being checked before they're written)
  readonly property string failedProblem: "niri couldn't load its config (see niri's log, or run `niri validate`), so it still runs the one before."

  // niri takes axiom's layer from files only (CompositorConfigManager)
  readonly property bool liveByFile: true

  // --- The layer as niri's config (NiriConf) ---

  // What the bind nodes need from outside the bind
  readonly property var _bindCtx: ({
      "axiomPath": Paths.axiomPath.replace(/\/$/, ""),
      "shellCommand": shellCommand,
      "restartCommand": Paths.restartCommand,
      "terminal": Apps.terminalCommand,
      "fileManager": Apps.fileManagerCommand,
      "browser": Apps.browserCommand
    })

  // Whether a configured bind has everything it needs to be bound
  function isComplete(bind) {
    return NiriConf.isComplete(bind, _bindCtx);
  }

  // axiom's binds against the user's (BindKeys.runtimeBinds): those to
  // write, and those whose key the user's config already binds
  readonly property var _plan: BindKeys.runtimeBinds(KeybindsConfig.activeBinds.filter(bind => root.isComplete(bind)), _userEntries ?? [])
  on_PlanChanged: {
    for (const key of _plan.skipped) {
      const id = BindKeys.keyId(key);
      if (!_reportedTaken[id])
        console.log(`[NiriConfigWriter] ${key} is bound by your niri config; leaving axiom's bind out`);
      _reportedTaken[id] = true;
    }
    KeybindManager.refreshSoon();
  }
  property var _reportedTaken: ({})

  // The saved monitor profile for what's connected (MonitorLayout.
  // matchProfile, as MonitorManager applies it) as `output` nodes, or null
  // until MonitorManager has read the outputs, when a file keeps what it
  // says (so a start doesn't write them out and back)
  readonly property var _outputNodes: {
    if (!MonitorManager.outputsRead)
      return null;
    const outputs = MonitorManager.outputs;
    const profiles = MonitorsConfig.profiles;
    const index = MonitorLayout.matchProfile(profiles, outputs.filter(output => !output.disabled));
    return index < 0 ? [] : NiriConf.outputNodes(profiles[index].outputs.filter(rule => MonitorLayout.find(rule.output, outputs) !== null));
  }

  function _outputsIn(path) {
    return _outputNodes ?? NiriConf.fileOutputNodes(FileManager.read(path));
  }

  // The parts every file holds, from `spec` (CompositorConfigManager.spec)
  function _parts(spec, path) {
    // reads: Workspaces.stripColumnWidth
    const schema = ConfigManager.configSchema?.properties;
    return {
      "header": _header,
      "includeLines": includeLines,
      "binds": NiriConf.bindsNode(_plan.apply, _bindCtx),
      "outputs": _outputsIn(path),
      "options": NiriConf.optionNodes(schema?.Workspaces, WorkspacesConfig.stripOptions, false),
      "look": NiriConf.lookNodes(spec.look).concat(NiriConf.surfaceBlurNodes(spec.surfaces)),
      "input": NiriConf.inputNodes(spec.input, schema?.Input)
    };
  }

  // The included file, from `spec` (CompositorConfigManager.spec(true))
  function moduleText(spec) {
    return NiriConf.moduleText(_parts(spec, includePath));
  }

  // The managed niri config, from `spec` as for moduleText: the
  // WindowBehaviour options and the session too, and the user's files
  function managedText(spec) {
    // reads: WindowBehaviour.*, Niri.*, Session.*
    const parts = _parts(spec, managedPath);
    const schema = ConfigManager.configSchema?.properties;
    return NiriConf.managedText(Object.assign(parts, {
      "userDir": userDir,
      "userFiles": _userFiles,
      "options": NiriConf.optionNodes(schema?.WindowBehaviour, WindowBehaviourConfig.behaviour, false).concat(NiriConf.optionNodes(schema?.Niri, NiriConfig.options, false), parts.options),
      "env": CompositorLayer.sessionEnv(SessionConfig.session, spec.input.cursor, {
        "qt": ThemeIntegrations.qt
      }),
      "start": {
        "command": startCommand,
        "idle": Idle.enabled,
        "polkit": PolkitConfig.enabled
      },
      "autostart": SessionConfig.session.autostart,
      "isAgent": command => PolkitAgents.isAgentCommand(command)
    }));
  }

  // The config leaving managed gives back when the takeover set nothing
  // aside: it starts axiom and includes the user's files, then in
  // included mode its module, at the end as includeTarget places it
  function releasedText(mode) {
    return NiriConf.releasedText(userDir, _userFiles, [NiriConf.node("spawn-sh-at-startup", [startCommand])], mode === "included" ? [NiriConf.node("include", [includePath])] : []);
  }

  // The included file once axiom isn't in that mode
  readonly property string emptyModuleText: NiriConf.emptyModuleText(_header)

  // Everything else the layer is made of (CompositorConfigManager re-applies
  // the layer when it changes)
  readonly property string inputsKey: [WindowBehaviourConfig._behaviourJson, NiriConfig._optionsJson, Apps.terminalCommand, Apps.fileManagerCommand, Apps.browserCommand, Idle.enabled, PolkitConfig.enabled, JSON.stringify(_outputNodes), JSON.stringify(_plan), _userFiles.join(",")].join("|")

  // The user's files in user/, in name order, as the managed config
  // includes them (niri takes no globs): a new one rewrites it. Listed at
  // start, after a takeover (which makes the folder) and whenever the
  // folder changes
  property var _userFiles: []

  function _readUserFiles(callback) {
    CommandManager.run(["find", root.userDir, "-maxdepth", "1", "-type", "f", "-name", "*.kdl", "-not", "-name", ".*", "-printf", "%f\\n"], (code, out) => {
      const names = String(out).split("\n").filter(name => name !== "").sort();
      if (JSON.stringify(names) !== JSON.stringify(root._userFiles))
        root._userFiles = names;
      callback?.();
    });
  }

  // Tells of a change in user/ (a FolderListModel watches a folder only
  // once it exists: it's pointed at it again after a takeover makes it)
  FolderListModel {
    id: userFolder
    folder: "file://" + root.userDir
    nameFilters: ["*.kdl"]
    showDirs: false
    onCountChanged: root._readUserFiles()
  }

  // Checks `text` (a whole file of axiom's) with niri itself before it's
  // written, its includes left out (they name the user's files, checked
  // when niri loads them), then calls back with "" or niri's error
  function validate(text, callback) {
    const own = text.split("\n").filter(line => !/^\s*include\s/.test(line)).join("\n");
    CommandManager.run(["sh", "-c", "niri validate -c /dev/stdin 2>&1"], (code, out) => {
      callback(code === 0 ? "" : String(out).split("\n").filter(line => line !== "" && !/ (DEBUG|INFO) /.test(line)).join("\n").trim() || "niri validate failed");
    }, own);
  }

  // --- At runtime: nothing but the files ---

  // niri takes nothing at runtime: its files carry the look and the input
  function liveLines(spec) {
    return [];
  }

  property var liveLinesHook: () => []
  // CompositorConfigManager's spec(forFile), for the detached mode's file
  property var specHook: forFile => null

  function runLive(lines) {
  }

  function setCursor(cursor) {
  }

  // --- The detached mode: a wrapper niri loads in place of the user's config ---

  // The runtime layer (detached, and the fallback of the file modes): the
  // module and the wrapper written (each if changed), and the wrapper
  // loaded unless it is
  function runtimeApply() {
    _runtimeOn = true;
    const spec = root.specHook(true);
    if (!spec || root._userEntries === null)
      return;
    const module = NiriConf.moduleText(_parts(spec, detachedPath));
    const wrapper = NiriConf.wrapperText(_header, _mainConfig, detachedPath);
    // Checks finish in any order: only the last asked for is written
    const asked = ++_runtimeWrites;
    root.validate(module, error => {
      if (!root._runtimeOn || asked !== root._runtimeWrites)
        return;
      if (error) {
        console.warn("[NiriConfigWriter]", root.invalidProblem(error));
        return;
      }
      root._writeIfChanged(detachedWriter, root.detachedPath, module);
      root._writeIfChanged(wrapperWriter, root.wrapperPath, wrapper);
      if (!root._wrapperLoaded)
        root._loadConfig(root.wrapperPath, true);
    });
  }

  // Takes the runtime layer out: niri loads the user's config again
  function runtimeClear() {
    _runtimeOn = false;
    if (_wrapperLoaded)
      _loadConfig(_mainConfig, false);
  }

  property bool _runtimeOn: false
  property int _runtimeWrites: 0

  // niri reloaded its config: a reload keeps the wrapper loaded
  function noteReload() {
  }

  // Loads `path` as niri's config (load-config-file), noting whether it's
  // the wrapper
  function _loadConfig(path, wrapper) {
    NiriIpcManager.action({
      "LoadConfigFile": {
        "path": path
      }
    }, ok => {
      if (ok)
        root._wrapperState.save({
          "socket": NiriIpcManager.socketPath,
          "loaded": wrapper
        });
      root._wrapperLoaded = ok ? wrapper : root._wrapperLoaded;
    });
  }

  // The config niri runs now: the wrapper while it's loaded, else the
  // user's (what NiriManager reads niri's gaps from)
  readonly property string runningConfig: _wrapperLoaded ? wrapperPath : _mainConfig

  // Whether niri runs the wrapper, kept across reloads of the shell (state:
  // niri keeps it until it restarts, a new niri having another socket)
  property bool _wrapperLoaded: false
  readonly property var _wrapperState: StateManager.createStateHandler("niriDetached")

  function _writeIfChanged(view, path, text) {
    if (FileManager.read(path) === text)
      return;
    view.path = "";
    view.path = path;
    view.setText(text);
  }

  FileView {
    id: detachedWriter
    atomicWrites: true
    blockLoading: true
    printErrors: false
    onSaveFailed: error => console.warn("[NiriConfigWriter] Could not write", detachedWriter.path, error)
  }

  FileView {
    id: wrapperWriter
    atomicWrites: true
    blockLoading: true
    printErrors: false
    onSaveFailed: error => console.warn("[NiriConfigWriter] Could not write", wrapperWriter.path, error)
  }

  // --- Whether a file is in effect ---

  // Calls back with whether the mode's file is in effect: the included
  // module reached from the user's config, or the managed config being
  // niri's (it starts with the header); "failed" when niri couldn't load
  // its config at all
  function checkLoaded(callback) {
    if (NiriManager.lastLoadFailed) {
      callback("failed");
      return;
    }
    if (CompositorConfig.mode === "managed") {
      callback(root._mainConfig === root.managedPath && FileManager.read(root.managedPath).startsWith(root._header));
      return;
    }
    CommandManager.run([Paths.scriptsPath + "niri_config.py", "includes"], (code, out) => {
      let files = [];
      try {
        files = JSON.parse(out).files;
      } catch (e) {}
      callback(code === 0 && files.includes(root.includePath));
    });
  }

  // niri reloads the files it loads as they change, but not a module it
  // doesn't load yet: reloading now (the config it runs, the wrapper
  // too) has its ConfigLoaded tell CompositorConfigManager to check again
  function reload(callback) {
    NiriIpcManager.action({
      "LoadConfigFile": {
        "path": null
      }
    }, () => callback?.());
  }

  // --- The user's config ---

  // The config niri started with (niri_config.py main): the user's,
  // whatever niri runs now (the detached wrapper)
  property string _mainConfig: managedPath
  // The binds the user's own config holds (BindKeys' entries; axiom's files
  // left out: the modules, and the managed config's own nodes), or null
  // until read
  property var _userEntries: null
  // Whether they've been read (NiriManager.ready waits for it, so a module
  // never binds a key the user's config does)
  readonly property bool userBindsRead: _userEntries !== null
  property int _userReads: 0

  function _readUserConfig() {
    // Reads finish in any order: only the last asked for counts
    const asked = ++root._userReads;
    CommandManager.run([Paths.scriptsPath + "niri_config.py", "main"], (code, out) => {
      if (asked !== root._userReads)
        return;
      try {
        root._mainConfig = JSON.parse(out).main;
      } catch (e) {}
    });
    CommandManager.run([Paths.scriptsPath + "niri_config.py", "binds", "--skip", root.includePath, "--skip", root.detachedPath, "--skip-header", root._header], (code, out, err) => {
      if (asked !== root._userReads)
        return;
      if (code !== 0) {
        console.warn("[NiriConfigWriter] Can't read your niri config:", String(err).trim());
        // Nothing of the user's known: none skipped
        if (root._userEntries === null)
          root._userEntries = [];
        return;
      }
      try {
        const entries = JSON.parse(out);
        if (JSON.stringify(entries) !== JSON.stringify(root._userEntries))
          root._userEntries = entries;
      } catch (e) {}
    });
  }

  property Connections _reloads: Connections {
    target: NiriManager

    function onConfigReloaded() {
      root._readUserConfig();
    }
  }

  Component.onCompleted: {
    const state = _wrapperState.load(null);
    _wrapperLoaded = state?.socket === NiriIpcManager.socketPath && state?.loaded === true;
    _readUserConfig();
    _readUserFiles();
  }

  // --- The binds in effect (NiriManager.withMainBinds) ---

  // Calls back with the user's binds and axiom's in effect (BindKeys'
  // entries), or null before they're read
  function withEntries(callback) {
    if (root._userEntries === null) {
      callback(null);
      return;
    }
    callback(root._userEntries.concat(NiriConf.bindEntries(root._plan.apply, root._bindCtx)));
  }

  // --- Managed takeover: ConfigTakeover, on claim_niri.sh ---

  // The takeover of the config is done (`adopted`: the file name the
  // previous one went to in user/, or "")
  signal claimed(string adopted)
  // It won't take over (blockedProblem)
  signal blocked
  // Leaving managed is done: "restored" | "written" | …
  signal released(string result)

  ConfigTakeover {
    id: takeover
    mode: CompositorConfig.mode
    script: Paths.scriptsPath + "claim_niri.sh"
    configDir: Paths.niriPath
    managedPath: root.managedPath
    userDir: root.userDir
    userFiles: root.userFiles
    header: root._header
    releasedText: root.releasedText(CompositorConfig.mode)
    monitorPattern: "^[[:space:]]*output[[:space:]]"
    monitorGlob: "*.kdl"
    logTag: "NiriConfigWriter"
    // The managed config includes what's in user/ now (the adopted file)
    onClaimed: (result, adopted) => root._readUserFiles(() => {
        userFolder.folder = "";
        userFolder.folder = "file://" + root.userDir;
        root.claimed(adopted);
      })
    onBlocked: root.blocked()
    onReleased: result => root.released(result)
  }

  // What switching to managed would do (ConfigTakeover.managedCheck)
  readonly property alias managedCheck: takeover.managedCheck
  readonly property alias managedBlockedBy: takeover.managedBlockedBy
  readonly property alias managedBlockedRepo: takeover.managedBlockedRepo
  // Managed mode: the files in user/ that set outputs themselves
  readonly property alias monitorConflicts: takeover.monitorConflicts

  // `callback` (optional) gets managedCheck once known
  function checkManaged(callback) {
    takeover.checkManaged(callback);
  }

  function claim() {
    takeover.claim();
    takeover.findMonitorConflicts();
  }

  function release() {
    takeover.release();
  }

  function findMonitorConflicts() {
    takeover.findMonitorConflicts();
  }

  function clearConflicts() {
    takeover.clearConflicts();
  }

  // --- Moving the user's binds into axiom: UserBindMerge, on merge_niri_binds.py ---

  UserBindMerge {
    id: bindMerge
    enabled: CompositorConfig.mode === "managed"
    script: Paths.scriptsPath + "merge_niri_binds.py"
    configDir: Paths.niriPath
    userDir: root.userDir
    logTag: "NiriConfigWriter"
    onBindsMerged: binds => root.bindsMerged(binds)
  }

  readonly property alias merging: bindMerge.merging
  // The last merge (UserBindMerge.lastMerge), or null
  readonly property alias lastMerge: bindMerge.lastMerge
  // How many binds a Merge of all of user/ would move; -1 until looked
  readonly property alias mergeable: bindMerge.mergeable
  // The binds a merge moved in for good
  signal bindsMerged(var binds)

  // `only`: one file name in user/ (the adopted one), else all of them
  function mergeUserBinds(only) {
    bindMerge.mergeUserBinds(only);
  }

  // Counts what a Merge would move, changing nothing (`mergeable`)
  function previewMerge() {
    bindMerge.previewMerge();
  }
}
