pragma Singleton
pragma ComponentBehavior: Bound

import QtQuick
import Quickshell

import qs.config
import qs.components.methods

/*
 * Hyprland's config writer (docs/dev/compositor/config-modes.md), reached
 * as HyprlandManager.configWriter by CompositorConfigManager, which drives
 * the modes. Turns axiom's layer (binds, required settings, the window
 * look, input, blur, monitor profiles, strips) into Hyprland's Lua:
 *   detached  evaluated at runtime (HyprlandRuntimeLayer); binds on keys
 *             already taken are skipped
 *   included  the module at $XDG_STATE_HOME/axiom/hyprland.lua, which the
 *             user's hyprland.lua loads (includeLines)
 *   managed   ~/.config/hypr/hyprland.lua itself, with the Hyprland
 *             section's options, loading ~/.config/hypr/user/*.lua after it
 * Also the managed takeover (ConfigTakeover, on claim_hyprland.sh) and
 * moving the user's binds into axiom (UserBindMerge, on merge_hypr_binds.py).
 */
Singleton {
  id: root

  // Configured keys the runtime layer skipped because Hyprland's config
  // already binds them
  readonly property alias skippedKeys: runtime.skippedKeys

  // --- Files and the lines a user's config needs ---

  readonly property string configDir: Paths.hyprlandPath
  readonly property string includePath: Paths.userStatePath + "hyprland.lua"
  readonly property string managedPath: Paths.hyprlandPath + "hyprland.lua"
  readonly property string userDir: Paths.hyprlandPath + "user"
  // Where the user's own config goes in managed mode
  readonly property string userFiles: userDir + "/*.lua"
  // What the user's hyprland.lua needs for the included mode
  readonly property string includeLines: `local ok, axiom = pcall(dofile, ${_lua(includePath)})\nif ok then axiom.setup() end`

  // What a hyprland.lua needs to start axiom with Hyprland, for the
  // detached and included modes (managed starts it itself). One line, marked
  // as install.sh's is, so applying it never splits a block.
  readonly property string autostartLines: `hl.on("hyprland.start", function() hl.exec_cmd(${_lua(startCommand)}) end) -- axiom`

  // The lines above as integration_hookup.py targets in the user's
  // hyprland.lua (IntegrationHookupManager's "compositorInclude" and
  // "compositorAutostart"): the include goes first, so what follows
  // overrides it, and the autostart last. Any line starting axiom counts,
  // install.sh's included.
  readonly property var includeTarget: ({
      // I18n.tr("Load axiom's module")
      "title": "Load axiom's module",
      "file": managedPath,
      "text": includeLines,
      "place": "start",
      "comment": "--",
      "accept": "axiom\\.setup\\(",
      // I18n.tr("Adds the lines at the top, so your own settings after them win over axiom's.")
      "note": "Adds the lines at the top, so your own settings after them win over axiom's."
    })
  readonly property var autostartTarget: ({
      // I18n.tr("Start axiom")
      "title": "Start axiom",
      "file": managedPath,
      "text": autostartLines,
      "place": "end",
      "comment": "--",
      "accept": Paths.startPattern,
      // I18n.tr("Adds the line at the end: Hyprland starts axiom with every session.")
      "note": "Adds the line at the end: Hyprland starts axiom with every session."
    })

  // How Hyprland and its binds start or call axiom (Paths.shellCommand)
  readonly property string shellCommand: Paths.shellCommand
  // Starting it: a second `axiom run` on the display exits at once (the
  // instance lock), so a reloaded hyprland.lua can't start another copy
  readonly property string startCommand: `${shellCommand} run`
  readonly property string _header: "-- Generated by axiom"

  // Why a file mode isn't in effect (CompositorConfigManager.problem)
  readonly property string notIncludedProblem: `Compositor mode is "included", but hyprland.lua doesn't load ${includePath}; add:\n${includeLines}`
  readonly property string notManagedProblem: `Compositor mode is "managed", but ${managedPath} isn't loaded (see hyprctl configerrors)`
  readonly property string blockedProblem: `Compositor mode is "managed", but ${Paths.hyprlandPath} is a symlink or in a git repository, so axiom won't take it over; use "included" instead. Applying axiom's layer at runtime meanwhile.`

  // --- The Lua layer (HyprConfigLua; what each bind action is, the
  // Keybinds page reads from BindActions directly) ---

  // What the bind Lua needs from outside the bind
  readonly property var _bindCtx: ({
      "shellCommand": shellCommand,
      "restartCommand": Paths.restartCommand,
      "terminal": Apps.terminalCommand,
      "fileManager": Apps.fileManagerCommand,
      "browser": Apps.browserCommand
    })

  // A Lua string literal
  function _lua(text) {
    return HyprLua.string(text);
  }

  // Whether a configured bind has everything it needs to be bound
  function isComplete(bind) {
    return HyprConfigLua.bindLua(bind, _bindCtx) !== "";
  }

  function _stripsLua() {
    return HyprLua.stripsLua(WorkspacesConfig.strips, ConfigManager.configSchema?.properties?.Workspaces, WorkspacesConfig.stripOptions);
  }

  // The look and the input (CompositorLayer.look / .input) as Lua lines
  function _lookLua(look, input) {
    const schema = ConfigManager.configSchema?.properties;
    return HyprLua.lookLua(look, schema?.WindowLook).concat(HyprLua.inputLua(input, schema?.Input));
  }

  // The included file, from `spec` (CompositorConfigManager.spec(true)): a
  // module whose setup() applies what's enabled
  function moduleText(spec) {
    const schema = ConfigManager.configSchema?.properties;
    return HyprConfigLua.moduleLua({
      "header": _header,
      "includeLines": includeLines,
      "requiredSettings": CompositorConfig.requiredSettings,
      "binds": HyprConfigLua.bindLines(KeybindsConfig.activeBinds, _bindCtx),
      "look": HyprLua.lookLua(spec.look, schema?.WindowLook),
      "input": HyprLua.inputLua(spec.input, schema?.Input),
      "blur": HyprLua.blurLua(spec.surfaces),
      "layers": HyprLua.layerRulesLua(),
      "monitors": HyprLua.monitorsLua(MonitorsConfig.profiles),
      "strips": _stripsLua()
    });
  }

  // The shell's motion (Look & Feel → Motion), for the managed animations
  readonly property var _motion: ({
      "fast": Appearance.animFast,
      "normal": Appearance.animNormal,
      "slow": Appearance.animSlow,
      "enabled": Appearance.animations
    })

  // The managed hyprland.lua, from `spec` as for moduleText
  function managedText(spec) {
    // reads: Compositor.hyprland.*, WindowBehaviour.*, Session.*
    const schema = ConfigManager.configSchema?.properties;
    return HyprConfigLua.managedLua(moduleText(spec), Object.assign({}, HyprlandConfig.managed, WindowBehaviourConfig.behaviour), {
      "header": _header,
      "userDir": userDir,
      "session": SessionConfig.session,
      "env": CompositorLayer.sessionEnv(SessionConfig.session, spec.input.cursor, {
        "qt": ThemeIntegrations.qt
      }),
      "cursor": spec.input.cursor,
      // Hyprland's own options and the shared ones, as one
      "schema": {
        "properties": Object.assign({}, schema?.Compositor?.properties?.hyprland?.properties, schema?.WindowBehaviour?.properties)
      },
      "resolveHex": name => HyprConfigLua.hex(Theme.resolveColor(name)),
      "motion": _motion,
      "start": {
        "command": startCommand,
        "idle": Idle.enabled,
        "polkit": PolkitConfig.enabled
      }
    });
  }

  // The included module once axiom isn't in that mode (every part a no-op)
  readonly property string emptyModuleText: HyprConfigLua.emptyModuleLua(_header)

  // The hyprland.lua leaving managed gives back when the takeover set
  // nothing aside (claim_hyprland.sh release), starting axiom (and loading
  // its module in included mode)
  function releasedText(mode) {
    return HyprConfigLua.releasedLua(userDir, (mode === "included" ? includeLines + "\n" : "") + autostartLines);
  }

  // Everything else the layer is made of (CompositorConfigManager re-applies
  // the layer when it changes)
  readonly property string inputsKey: [HyprlandConfig._managedJson, WindowBehaviourConfig._behaviourJson, Theme.baseColorNames.map(name => Theme.resolveColor(name)).join(","), Appearance.animFast, Appearance.animations, Apps.terminalCommand, Apps.fileManagerCommand, Apps.browserCommand, Idle.enabled, PolkitConfig.enabled].join("|")

  // --- At runtime ---

  // The look, the input and the blur as Lua lines evaluated now, from
  // `spec` (CompositorConfigManager.spec(false))
  function liveLines(spec) {
    return _lookLua(spec.look, spec.input).concat(HyprLua.blurLua(spec.surfaces));
  }

  // CompositorConfigManager's: the live lines, noting which parts they
  // apply. The runtime layer evaluates them with the rest.
  property var liveLinesHook: () => []

  // Evaluates `lines` now, then reads the options back (gapsOut)
  function runLive(lines) {
    HyprlandManager.runLua(lines.join("\n"));
    HyprlandManager.refreshOptions();
  }

  // `cursor`: CompositorLayer.input()'s. Hyprland takes the theme by its
  // own name (a hyprcursor theme too) and fills in missing names itself
  function setCursor(cursor) {
    HyprlandManager.setCursor(cursor.theme, cursor.size);
  }

  HyprlandRuntimeLayer {
    id: runtime
    bindCtx: root._bindCtx
    lookLines: () => root.liveLinesHook()
    // Strips once per Hyprland load (HyprLua.stripsRuntimeLua)
    stripsLines: () => HyprLua.stripsRuntimeLua(root._stripsLua(), WorkspacesConfig._stripsJson)
  }

  // The runtime layer (detached, and the fallback of the file modes)
  function runtimeApply() {
    runtime.apply();
  }

  // Takes the runtime layer's binds out (the file is loaded now)
  function runtimeClear() {
    runtime.clear();
  }

  // Hyprland reloaded its config, dropping the runtime layer
  function noteReload() {
    runtime.noteReload();
  }

  // Calls back with whether the file is in effect: Hyprland answers "ok"
  // when the file's marker is set in its Lua state
  function checkLoaded(callback) {
    HyprlandIpcManager.evalLua("if not AXIOM_INCLUDED then error('axiom: not loaded') end", reply => callback(reply === "ok"));
  }

  // Reloads Hyprland's config (it doesn't watch files a config loads)
  function reload(callback) {
    HyprlandIpcManager.request("reload", callback);
  }

  // --- Managed takeover: ConfigTakeover, on claim_hyprland.sh ---

  // The takeover of hyprland.lua is done (`adopted`: the file name the
  // previous one went to in user/, or "")
  signal claimed(string adopted)
  // It won't take over (blockedProblem)
  signal blocked
  // Leaving managed is done: "restored" | "written" | …
  signal released(string result)

  ConfigTakeover {
    id: takeover
    mode: CompositorConfig.mode
    script: Paths.scriptsPath + "claim_hyprland.sh"
    configDir: Paths.hyprlandPath
    managedPath: root.managedPath
    userDir: root.userDir
    userFiles: root.userFiles
    header: root._header
    releasedText: root.releasedText(CompositorConfig.mode)
    monitorPattern: "^[[:space:]]*hl\\.monitor[[:space:]]*\\("
    monitorGlob: "*.lua"
    logTag: "HyprlandConfigWriter"
    onClaimed: (result, adopted) => root.claimed(adopted)
    onBlocked: root.blocked()
    onReleased: result => root.released(result)
  }

  // What switching to managed would do (ConfigTakeover.managedCheck)
  readonly property alias managedCheck: takeover.managedCheck
  readonly property alias managedBlockedBy: takeover.managedBlockedBy
  readonly property alias managedBlockedRepo: takeover.managedBlockedRepo
  // Managed mode: the user/*.lua files that set monitors themselves
  readonly property alias monitorConflicts: takeover.monitorConflicts

  // `callback` (optional) gets managedCheck once known
  function checkManaged(callback) {
    takeover.checkManaged(callback);
  }

  function claim() {
    takeover.claim();
    takeover.findMonitorConflicts();
  }

  function release() {
    takeover.release();
  }

  function findMonitorConflicts() {
    takeover.findMonitorConflicts();
  }

  function clearConflicts() {
    takeover.clearConflicts();
  }

  // --- Moving the user's binds into axiom: UserBindMerge, on merge_hypr_binds.py ---

  UserBindMerge {
    id: bindMerge
    enabled: CompositorConfig.mode === "managed"
    script: Paths.scriptsPath + "merge_hypr_binds.py"
    configDir: Paths.hyprlandPath
    userDir: root.userDir
    logTag: "HyprlandConfigWriter"
    onBindsMerged: binds => root.bindsMerged(binds)
  }

  readonly property alias merging: bindMerge.merging
  // The last merge (UserBindMerge.lastMerge), or null
  readonly property alias lastMerge: bindMerge.lastMerge
  // How many binds a Merge of all of user/ would move; -1 until looked
  readonly property alias mergeable: bindMerge.mergeable
  // The binds a merge moved in for good
  signal bindsMerged(var binds)

  // `only`: one file name in user/ (the adopted one), else all of them
  function mergeUserBinds(only) {
    bindMerge.mergeUserBinds(only);
  }

  // Counts what a Merge would move, changing nothing (`mergeable`)
  function previewMerge() {
    bindMerge.previewMerge();
  }
}
