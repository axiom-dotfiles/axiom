pkgbase = axiom-shell
	pkgdesc = A Quickshell desktop shell for Hyprland, sway and niri: bar, launcher, notifications, lock and login screens, overlay pages
	pkgver = 1.1.11
	pkgrel = 1
	url = https://github.com/axiom-shell/axiom
	install = axiom-shell.install
	arch = any
	license = MIT
	depends = quickshell>=0.3.2
	depends = jq
	depends = curl
	depends = python
	depends = ttf-material-symbols-variable
	optdepends = hyprland: the compositor with every feature
	optdepends = niri: run axiom under niri
	optdepends = sway: run axiom under sway (swayfx provides it), and the compositor the login screen runs in
	optdepends = xorg-xwayland: X11 apps under sway (Steam, games, older apps)
	optdepends = xwayland-satellite: X11 apps under niri (Steam, games, older apps)
	optdepends = awww: wallpapers
	optdepends = python-numpy: themes generated from your wallpaper
	optdepends = python-pillow: themes generated from your wallpaper
	optdepends = python-icalendar: calendar accounts and feeds
	optdepends = libsecret: calendar accounts and feeds
	optdepends = networkmanager: Wi-Fi menu and network widget
	optdepends = pacman-contrib: package update checks
	optdepends = wl-clipboard: copying screenshots, the launcher calculator and emoji, clipboard history
	optdepends = wf-recorder: screen recording
	optdepends = grim: screenshots (niri)
	optdepends = satty: annotating screenshots
	optdepends = libqalculate: launcher calculator
	optdepends = wtype: typing emoji from the launcher
	optdepends = cliphist: clipboard history with images, shared with other apps
	optdepends = brightnessctl: brightness keys and OSD bar (laptop panels)
	optdepends = ddcutil: brightness keys and OSD bar (external monitors over DDC/CI)
	optdepends = hypridle: locking on idle
	optdepends = hyprsunset: night light (Hyprland)
	optdepends = wlsunset: night light (sway, niri)
	optdepends = power-profiles-daemon: power profiles
	optdepends = xdg-desktop-portal-gtk: browse buttons for folders and importing configs
	optdepends = python-gobject: browse buttons for folders and importing configs
	optdepends = greetd: axiom as the login screen (set up from Settings → Login screen)
	optdepends = greetd-agreety: axiom as the login screen (its text fallback)
	source = axiom-shell-1.1.11.tar.gz::https://github.com/axiom-shell/axiom/archive/refs/tags/v1.1.11.tar.gz
	sha256sums = 781e3419b4b3397ab5103a826fd4838f61299c951fc925987219db07574a3e6c

pkgname = axiom-shell
