              "showCalendar": true,
              "backgroundColor": "base0C",
              "foregroundColor": "base00",
              "verticalDate": "day"
            }
          }
        ],
        "rightCenter": [],
        "right": [
          {
            "type": "IdleInhibitor",
            "layout": {},
            "properties": {
              "showLabel": false,
              "activeColor": "base0A",
              "inactiveColor": "base02",
              "foregroundColor": "base00"
            }
          },
          {
            "type": "Media",
            "layout": {},
            "properties": {
              "showArtist": true,
              "artistLength": 10,
              "idleText": "No player",
              "showPopout": true,
              "playingColor": "base0B",
              "pausedColor": "base02",
              "foregroundColor": "base00"
            }
          },
          {
            "type": "SystemStats",
            "layout": {},
            "properties": {
              "showCpu": true,
              "showMemory": true,
              "memoryFormat": "percent",
              "showTemp": true,
              "showGpu": false,
              "showDisk": false,
              "diskPath": "/",
              "interval": 2000,
              "showPopout": true,
              "warnThreshold": 90,
              "backgroundColor": "base0E",
              "warnColor": "base08",
              "foregroundColor": "base00"
            }
          },
          {
            "type": "Notifications",
            "layout": {},
            "properties": {
              "showCount": true,
              "showPopout": true,
              "backgroundColor": "base0D",
              "foregroundColor": "base00",
              "dndColor": "base04",
              "badgeColor": "base08"
            }
          },
          {
            "type": "Button",
            "layout": {},
            "properties": {
              "icon": "apps",
              "label": "",
              "tooltip": "",
              "action": "powerMenu",
              "command": "",
              "rightCommand": "",
              "middleCommand": "",
              "hoverActivate": false,
              "labelCommand": "",
              "labelInterval": 5000,
              "backgroundColor": "base0C",
              "foregroundColor": "base00",
              "menu": ""
            }
          }
        ]
      },
      "widgetSize": 30,
      "padding": 8,
      "widgetPadding": 10,
      "widgetSpacing": 4,
      "overrideFontSize": false,
      "fontSize": 14,
      "overrideRadius": false,
      "widgetRadius": 6
    }
  ],
  "Chat": {
    "defaultProvider": "gemini",
    "providers": [
      {
        "id": "anthropic",
        "name": "Anthropic",
        "kind": "anthropic",
        "baseUrl": "https://api.anthropic.com/v1",
        "auth": "key",
        "keyEnv": "ANTHROPIC_API_KEY",
        "models": [
          "claude-opus-5",
          "claude-sonnet-5",
          "claude-haiku-4-5",
          "claude-fable-5-1",
          "claude-opus-5-5"
        ],
        "defaultModel": "claude-opus-5",
        "fallbacks": true
      },
      {
        "id": "openai",
        "name": "OpenAI",
        "kind": "openai",
        "baseUrl": "https://api.openai.com/v1",
        "auth": "key",
        "keyEnv": "OPENAI_API_KEY",
        "models": [
          "gpt-5",
          "gpt-5-mini",
          "gpt-4"
        ],
        "defaultModel": "gpt-5",
        "fallbacks": false
      },
      {
        "id": "gemini",
        "name": "Gemini",
        "kind": "gemini",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "auth": "key",
        "keyEnv": "GEMINI_API_KEY",
        "models": [
          "gemini-2.5-pro",
          "gemini-2.5-flash"
        ],
        "defaultModel": "gemini-2.5-flash",
        "fallbacks": false
      },
      {
        "id": "ollama",
        "name": "Ollama",
        "kind": "openai",
        "baseUrl": "http://localhost:11434/v1",
        "auth": "none",
        "keyEnv": "",
        "models": [],
        "defaultModel": "",
        "fallbacks": false
      }
    ],
    "defaultPreset": "Default",
    "maxTokens": 16000,
    "keepConversations": 50,
    "showThinking": true,
    "renderMarkdown": true,
    "sendKey": "enter",
    "presets": [
      {
        "name": "Default",
        "icon": "chat",
        "systemPrompt": "You are a helpful assistant built into the user's Linux desktop. Answer concisely, and use Markdown when it helps.",
        "provider": "",
        "model": "",
        "effort": "default"
      },
      {
        "name": "Coder",
        "icon": "code",
        "systemPrompt": "You are an expert programmer. Lead with working code, then explain briefly. Prefer small, idiomatic changes.",
        "provider": "",
        "model": "",
        "effort": "high"
      }
    ]
  },
