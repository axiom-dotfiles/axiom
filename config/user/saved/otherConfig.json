              "scrollToSwitch": true,
              "activeColor": "base0E",
              "occupiedColor": "base04",
              "emptyColor": "base01",
              "textColor": "base00",
              "relativeNumbers": false,
              "spacing": 2
            }
          }
        ],
        "leftCenter": [],
        "center": [
          {
            "type": "Time",
            "layout": {},
            "properties": {
              "use24Hour": false,
              "showSeconds": true,
              "showDate": true,
              "timeFormat": "",
