{
  "$schema": "../json/config.schema.json",
  "version": 29,
  "General": {
    "displayName": "travmonkey",
    "primaryMonitor": "DP-1",
    "language": "en",
    "monitors": "primary"
  },
  "Appearance": {
    "wallpaper": "file:///home/travmonkey/Pictures/wallpapers/gate.png",
    "theme": "generated/wallpaper-tonal-dark",
    "font": {
      "family": "JetBrainsMono Nerd Font",
      "size": 16
    },
    "shape": {
      "radius": 14,
      "borderWidth": 3,
      "screenMargin": 8,
      "screenBorder": true
    },
    "motion": {
      "enabled": true,
      "speed": 100
    },
    "wallpaperFolder": "~/Pictures/wallpapers",
    "wallpapers": {
      "DP-1": "file:///home/travmonkey/Pictures/wallpapers/gate.png"
    },
    "wallpaperBackend": "quickshell",
    "wallpaperMode": "fixed",
    "wallpaperRotation": {
      "interval": 30,
      "order": "random",
      "sameOnAll": false
    },
    "variantWallpapers": {
      "dark": "",
      "light": ""
    },
    "themeSchedule": {
      "enabled": false,
      "lightAt": "07:00",
      "darkAt": "19:00"
    }
  },
  "Popouts": {
    "openDelay": 8,
    "dismissDelay": 225,
    "edgeTriggerSize": 5,
    "padding": 16
  },
  "Widget": {
    "height": 30,
    "padding": 10,
    "spacing": 4,
    "overrideRadius": false,
    "radius": 6
  },
  "Overlay": {
    "views": [
      {
        "type": "Custom",
        "name": "Home",
        "columns": [
          {
            "cells": [
              {
                "layout": "Single",
                "slots": {
                  "main": {
                    "type": "Notifications"
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              },
              {
                "layout": "Single",
                "slots": {
                  "main": {
                    "type": "AudioMixer",
                    "properties": {
                      "mode": "output"
                    }
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              }
            ]
          },
          {
            "cells": [
              {
                "layout": "Horiz1x2",
                "slots": {
                  "bottomLeft": {
                    "type": "Favourites",
                    "properties": {
                      "apps": [
                        "zen",
                        "vesktop",
                        "steam",
                        "kitty"
                      ],
                      "showLabels": false
                    }
                  },
                  "bottomRight": {
                    "type": "Updates",
                    "properties": {
                      "intervalMinutes": 60,
                      "includeAur": false,
                      "aurHelper": "paru"
                    }
                  },
                  "top": {
                    "type": "Network"
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              },
              {
                "layout": "Horiz1x1",
                "slots": {
                  "top": {
                    "type": "Weather",
                    "properties": {
                      "location": "Kyoto",
                      "latitude": "",
                      "longitude": "",
                      "units": "celsius"
                    }
                  },
                  "bottom": {
                    "type": "Disks",
                    "properties": {
                      "paths": [
                        "/",
                        "/home",
                        "/mnt/nvme",
                        "/mnt/ssd"
                      ]
                    }
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              },
              {
                "layout": "Wide",
                "slots": {
                  "main": {
                    "type": "NowPlaying"
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              }
            ]
          },
          {
            "cells": [
              {
                "layout": "Tall",
                "slots": {
                  "main": {
                    "type": "ClockCalendar",
                    "properties": {
                      "use24h": true,
                      "showSeconds": false
                    }
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              }
            ]
          },
          {
            "cells": [
              {
                "layout": "Single",
                "slots": {
                  "main": {
                    "type": "SystemGraphs",
                    "properties": {
                      "metrics": [
                        "cpu",
                        "mem",
                        "gpu",
                        "cpuTemp"
                      ]
                    }
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              },
              {
                "layout": "Horiz1x1",
                "slots": {
                  "top": {
                    "type": "QuickActions",
                    "properties": {
                      "actions": [
                        "wifi",
                        "bluetooth",
                        "caffeine",
                        "dnd",
                        "darkMode",
                        "nightLight"
                      ],
                      "labels": "auto"
                    }
                  },
                  "bottom": {
                    "type": "QuickActions",
                    "properties": {
                      "actions": [
                        "lock",
                        "suspend",
                        "logout",
                        "reboot",
                        "poweroff"
                      ],
                      "labels": "auto"
                    }
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              }
            ]
          }
        ]
      },
      {
        "type": "Custom",
        "name": "Chat",
        "columns": [
          {
            "cells": [
              {
                "layout": "Large",
                "slots": {
                  "main": {
                    "type": "Chat"
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              }
            ]
          },
          {
            "cells": [
              {
                "layout": "Single",
                "slots": {
                  "main": {
                    "type": "Notes",
                    "properties": {
                      "note": "",
                      "lockNote": false,
                      "showHeader": true,
                      "showToolbar": true,
                      "showCompleted": true
                    }
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              },
              {
                "layout": "Single",
                "slots": {
                  "main": {
                    "type": "ClockCalendar",
                    "properties": {
                      "use24h": true,
                      "showSeconds": false
                    }
                  }
                },
                "fillWidth": false,
                "fillHeight": false
              }
            ]
          }
        ]
      },
      {
        "type": "Settings"
      },
      {
        "type": "BarEditor"
      },
      {
        "type": "Themes"
      },
      {
        "type": "Keybinds"
      },
      {
        "type": "EdgeMenuEditor"
      },
      {
        "type": "Monitors"
      }
    ],
    "size": 117,
    "monitors": "general",
    "closeOnEscape": true,
    "closeOnOutsideClick": true
  },
  "Bars": [
    {
      "id": "bar-3",
      "enabled": true,
      "monitor": "DP-1",
      "location": "Top",
      "background": "solid",
      "pillPadding": 4,
      "pillMerge": 12,
      "spacing": 4,
      "lockCenter": true,
      "reserveSpace": true,
      "widgets": {
        "left": [
          {
            "type": "Button",
            "layout": {},
